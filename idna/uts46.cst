// =======================================================
// caustic-unicode/idna/uts46.cst
// UTS #46 processing: map code points via the IDNA table, NFC-normalize,
// split into labels, and Punycode encode/decode per label. Implements
// to_ascii (A-label form) and to_unicode (U-label form). flags bit 0 =
// Transitional_Processing (deviation chars ß/ς/ZWJ/ZWNJ map vs kept).
// =======================================================

use "../core/errno.cst"      as errno;
use "../core/buf.cst"        as buf;
use "../ucd/tables/idna.cst" as it;
use "../normalize/normalize.cst" as nz;
use "../utf/utf8.cst"        as utf8;
use "./punycode.cst"         as puny;

let is i64 as UTS46_TRANSITIONAL with imut = 1;
let is i64 as UTS46_USE_STD3     with imut = 2;

// IDNA status of a code point: 0 valid, 1 mapped, 2 deviation, 3 disallowed, 4 ignored.
fn idna_status(cp as i32) as i64 {
    let is i32 as idx = it.idna_get(cp);
    return cast(i64, (it.idna_meta_at(idx) >> 28) & 15);
}

fn _is_sep(cp as i32) as i64 {
    if (cp == 46 || cp == 12290 || cp == 65294 || cp == 65377) { return 1; }   // . 。 ．｡
    return 0;
}

// Map + NFC into `out`. Returns 0 ok, or 1 if a disallowed cp was present
// (the char is kept so a best-effort result is still produced).
fn _map(cps as *i32, n as i64, transitional as i64, out as *buf.CpBuf) as i64 {
    let is buf.CpBuf as tmp = buf.cpbuf_new(64);
    let is i64 as err with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i32 as cp = cps[i];
        let is i32 as idx = it.idna_get(cp);
        let is i32 as rec = it.idna_meta_at(idx);
        let is i64 as st = cast(i64, (rec >> 28) & 15);
        let is i32 as off = rec & 1048575;
        let is i32 as ln = (rec >> 20) & 255;
        if (st == 0) { buf.cpbuf_push(&tmp, cp); }
        else if (st == 1) { let is i32 as k with mut = 0; while (k < ln) { buf.cpbuf_push(&tmp, it.idna_pool_at(off + k)); k = k + 1; } }
        else if (st == 2) {
            if (transitional == 1) { let is i32 as k with mut = 0; while (k < ln) { buf.cpbuf_push(&tmp, it.idna_pool_at(off + k)); k = k + 1; } }
            else { buf.cpbuf_push(&tmp, cp); }
        }
        else if (st == 3) { buf.cpbuf_push(&tmp, cp); err = 1; }
        // st == 4 (ignored): drop
        i = i + 1;
    }
    nz.nfc(tmp.ptr, tmp.len, out);
    buf.cpbuf_free(&tmp);
    return err;
}

fn _label_is_xn(lab as *i32, n as i64) as i64 {
    if (n < 4) { return 0; }
    if (lab[0] == 120 && lab[1] == 110 && lab[2] == 45 && lab[3] == 45) { return 1; }   // "xn--"
    return 0;
}
fn _label_all_ascii(lab as *i32, n as i64) as i64 {
    let is i64 as i with mut = 0;
    while (i < n) { if (lab[i] > 127) { return 0; } i = i + 1; }
    return 1;
}

// to_ascii: append the A-label form to `out`. Returns byte count, or 0 - UERR_*.
fn to_ascii(src as *u8, n as i64, flags as i64, out as *buf.ByteBuf) as i64 {
    let is i64 as trans = flags & 1;
    let is buf.CpBuf as incp = buf.cpbuf_new(64);
    if (utf8.to_cps(src, n, &incp) < 0) { buf.cpbuf_free(&incp); return 0 - errno.UERR_INVALID; }
    let is buf.CpBuf as mp = buf.cpbuf_new(64);
    let is i64 as merr = _map(incp.ptr, incp.len, trans, &mp);
    let is i64 as err with mut = merr;

    let is buf.CpBuf as lab = buf.cpbuf_new(32);
    let is i64 as base = out.len;
    let is i64 as first with mut = 1;
    let is i64 as i with mut = 0;
    let is i64 as done with mut = 0;
    while (done == 0) {
        let is i64 as atend with mut = 0;
        let is i64 as issep with mut = 0;
        if (i >= mp.len) { atend = 1; }
        else if (_is_sep(mp.ptr[i]) == 1) { issep = 1; }
        if (atend == 1 || issep == 1) {
            if (first == 0) { buf.bytebuf_push(out, cast(u8, 46)); }
            first = 0;
            if (_label_all_ascii(lab.ptr, lab.len) == 1) {
                let is i64 as q with mut = 0;
                while (q < lab.len) { buf.bytebuf_push(out, cast(u8, lab.ptr[q])); q = q + 1; }
            } else {
                buf.bytebuf_push(out, cast(u8, 120)); buf.bytebuf_push(out, cast(u8, 110));
                buf.bytebuf_push(out, cast(u8, 45)); buf.bytebuf_push(out, cast(u8, 45));
                if (puny.punycode_encode(lab.ptr, lab.len, out) < 0) { err = 1; }
            }
            buf.cpbuf_reset(&lab);
            if (atend == 1) { done = 1; }
        } else {
            buf.cpbuf_push(&lab, mp.ptr[i]);
        }
        i = i + 1;
    }
    buf.cpbuf_free(&incp); buf.cpbuf_free(&mp); buf.cpbuf_free(&lab);
    if (err == 1) { return 0 - errno.UERR_DISALLOWED; }
    return out.len - base;
}

// to_unicode: append the U-label form (UTF-8) to `out`. Returns byte count.
fn to_unicode(src as *u8, n as i64, flags as i64, out as *buf.ByteBuf) as i64 {
    let is i64 as trans = flags & 1;
    let is buf.CpBuf as incp = buf.cpbuf_new(64);
    if (utf8.to_cps(src, n, &incp) < 0) { buf.cpbuf_free(&incp); return 0 - errno.UERR_INVALID; }
    let is buf.CpBuf as mp = buf.cpbuf_new(64);
    _map(incp.ptr, incp.len, trans, &mp);

    let is buf.CpBuf as lab = buf.cpbuf_new(32);
    let is buf.CpBuf as dec = buf.cpbuf_new(32);
    let is i64 as base = out.len;
    let is i64 as first with mut = 1;
    let is i64 as i with mut = 0;
    let is i64 as done with mut = 0;
    while (done == 0) {
        let is i64 as atend with mut = 0;
        let is i64 as issep with mut = 0;
        if (i >= mp.len) { atend = 1; }
        else if (_is_sep(mp.ptr[i]) == 1) { issep = 1; }
        if (atend == 1 || issep == 1) {
            if (first == 0) { buf.bytebuf_push(out, cast(u8, 46)); }
            first = 0;
            if (_label_is_xn(lab.ptr, lab.len) == 1) {
                // decode the part after "xn--": copy label[4..] to ascii bytes
                let is buf.ByteBuf as ab = buf.bytebuf_new(32);
                let is i64 as q with mut = 4;
                while (q < lab.len) { buf.bytebuf_push(&ab, cast(u8, lab.ptr[q])); q = q + 1; }
                buf.cpbuf_reset(&dec);
                if (puny.punycode_decode(ab.ptr, ab.len, &dec) >= 0) {
                    utf8.from_cps(dec.ptr, dec.len, out);
                } else {
                    utf8.from_cps(lab.ptr, lab.len, out);   // leave as-is on failure
                }
                buf.bytebuf_free(&ab);
            } else {
                utf8.from_cps(lab.ptr, lab.len, out);
            }
            buf.cpbuf_reset(&lab);
            if (atend == 1) { done = 1; }
        } else {
            buf.cpbuf_push(&lab, mp.ptr[i]);
        }
        i = i + 1;
    }
    buf.cpbuf_free(&incp); buf.cpbuf_free(&mp); buf.cpbuf_free(&lab); buf.cpbuf_free(&dec);
    return out.len - base;
}

// =======================================================
// caustic-unicode/width/width.cst
// Terminal/display column width. cp_width: 0 for control, format, and
// nonspacing/enclosing marks; 2 for East-Asian Wide/Fullwidth; else 1.
// (Per-code-point for now; grapheme-cluster-aware widths land with the
// segment module in a later phase.)
// =======================================================

use "../ucd/props.cst"        as props;
use "../ucd/tables/eaw.cst"   as eaw;
use "../utf/utf8.cst"         as utf8;
use "../core/buf.cst"         as buf;
use "../segment/grapheme.cst" as gr;

// Columns occupied by one code point: 0, 1, or 2.
fn cp_width(cp as i32) as i64 {
    let is i64 as gc = props.general_category(cp);
    if (gc == props.GC_CC || gc == props.GC_CF || gc == props.GC_MN || gc == props.GC_ME) { return 0; }
    let is i64 as ea = props.east_asian_width(cp);
    if (ea == eaw.EAW_W || ea == eaw.EAW_F) { return 2; }
    return 1;
}

// Like cp_width, but East-Asian Ambiguous counts as 2 when ambiguous_wide=1
// (CJK legacy context); otherwise 1.
fn cp_width_amb(cp as i32, ambiguous_wide as i64) as i64 {
    let is i64 as w = cp_width(cp);
    if (ambiguous_wide == 1 && w == 1) {
        if (props.east_asian_width(cp) == eaw.EAW_A) { return 2; }
    }
    return w;
}

// Grapheme-cluster-aware run width: each cluster contributes the max cp_width
// of its members, so a base+combining sequence counts as the base and an
// emoji ZWJ sequence counts as 2 (not the sum of its parts).
fn cp_run_width(cps as *i32, n as i64) as i64 {
    let is i64 as total with mut = 0;
    let is gr.GraphemeIter as it = gr.grapheme_iter(cps, n);
    let is i64 as start with mut = 0;
    let is i64 as e with mut = gr.grapheme_next(&it);
    while (e >= 0) {
        let is i64 as w with mut = 0;
        let is i64 as j with mut = start;
        while (j < e) {
            let is i64 as cw = cp_width(cps[j]);
            if (cw > w) { w = cw; }
            j = j + 1;
        }
        total = total + w;
        start = e;
        e = gr.grapheme_next(&it);
    }
    return total;
}

// Display width of a UTF-8 string (grapheme-cluster aware). Returns >= 0, or
// 0 - UERR_* on bad UTF-8.
fn string_width(src as *u8, n as i64) as i64 {
    let is buf.CpBuf as cps = buf.cpbuf_new(64);
    if (utf8.to_cps(src, n, &cps) < 0) { buf.cpbuf_free(&cps); return 0 - 1; }
    let is i64 as w = cp_run_width(cps.ptr, cps.len);
    buf.cpbuf_free(&cps);
    return w;
}

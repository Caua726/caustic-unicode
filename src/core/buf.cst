// =======================================================
// caustic-unicode/core/buf.cst
// CpBuf  — growable, owned code-point buffer (i32 elements). The
//          universal output currency for normalize/case/segment/etc.
// ByteBuf — growable, owned byte buffer (the *u8 analog, for encode
//          / punycode / utf8 output).
// Mirrors caustic-net/core/bytes.cst: a module-local bins allocator,
// doubling growth, negative return on alloc failure. len/cap are in
// ELEMENTS for CpBuf (4 bytes each) and in BYTES for ByteBuf.
// =======================================================

use "std/mem.cst" only bins, core as mem;

struct CpBuf {
    ptr as *i32;
    len as i64;
    cap as i64;
}

struct ByteBuf {
    ptr as *u8;
    len as i64;
    cap as i64;
}

let is mem.Bins as _bins with mut;
let is i32 as _ready with mut = 0;

fn _alloc(size as i64) as *u8 {
    if (_ready == 0) { _bins = mem.bins.bins_new(65536); _ready = 1; }
    return mem.bins.bins_alloc(&_bins, size);
}

fn _free(ptr as *u8) as void {
    if (_ready == 1) { mem.bins.bins_free(&_bins, ptr); }
}

// ---- CpBuf -------------------------------------------------------

// New code-point buffer with capacity `cap` elements (>=1). len = 0.
fn cpbuf_new(cap as i64) as CpBuf {
    let is i64 as c with mut = cap;
    if (c < 1) { c = 16; }
    let is CpBuf as b;
    b.ptr = cast(*i32, _alloc(c * 4));
    b.len = 0;
    b.cap = c;
    return b;
}

// Ensure room for `extra` more elements; doubles capacity if needed.
fn cpbuf_reserve(b as *CpBuf, extra as i64) as i64 {
    let is i64 as need = b.len + extra;
    if (need <= b.cap) { return 0; }
    let is i64 as ncap with mut = b.cap;
    while (ncap < need) { ncap = ncap * 2; }
    let is *i32 as np = cast(*i32, _alloc(ncap * 4));
    if (cast(i64, np) == 0) { return 0 - 1; }
    if (b.len > 0) { mem.core.memcpy(cast(*u8, np), cast(*u8, b.ptr), b.len * 4); }
    _free(cast(*u8, b.ptr));
    b.ptr = np;
    b.cap = ncap;
    return 0;
}

// Append a single code point. Returns 0 ok, <0 on alloc failure.
fn cpbuf_push(b as *CpBuf, cp as i32) as i64 {
    if (cpbuf_reserve(b, 1) < 0) { return 0 - 1; }
    b.ptr[b.len] = cp;
    b.len = b.len + 1;
    return 0;
}

// Append `n` code points from `src`. Returns 0 ok, <0 on alloc failure.
fn cpbuf_append(b as *CpBuf, src as *i32, n as i64) as i64 {
    if (n <= 0) { return 0; }
    if (cpbuf_reserve(b, n) < 0) { return 0 - 1; }
    mem.core.memcpy(cast(*u8, cast(i64, b.ptr) + b.len * 4), cast(*u8, src), n * 4);
    b.len = b.len + n;
    return 0;
}

fn cpbuf_get(b as *CpBuf, i as i64) as i32 {
    return b.ptr[i];
}

fn cpbuf_reset(b as *CpBuf) as void {
    b.len = 0;
}

fn cpbuf_free(b as *CpBuf) as void {
    if (cast(i64, b.ptr) != 0) { _free(cast(*u8, b.ptr)); }
    b.ptr = cast(*i32, 0);
    b.len = 0;
    b.cap = 0;
}

// ---- ByteBuf -----------------------------------------------------

fn bytebuf_new(cap as i64) as ByteBuf {
    let is i64 as c with mut = cap;
    if (c < 1) { c = 16; }
    let is ByteBuf as b;
    b.ptr = _alloc(c);
    b.len = 0;
    b.cap = c;
    return b;
}

fn bytebuf_reserve(b as *ByteBuf, extra as i64) as i64 {
    let is i64 as need = b.len + extra;
    if (need <= b.cap) { return 0; }
    let is i64 as ncap with mut = b.cap;
    while (ncap < need) { ncap = ncap * 2; }
    let is *u8 as np = _alloc(ncap);
    if (cast(i64, np) == 0) { return 0 - 1; }
    if (b.len > 0) { mem.core.memcpy(np, b.ptr, b.len); }
    _free(b.ptr);
    b.ptr = np;
    b.cap = ncap;
    return 0;
}

fn bytebuf_push(b as *ByteBuf, byte as u8) as i64 {
    if (bytebuf_reserve(b, 1) < 0) { return 0 - 1; }
    b.ptr[b.len] = byte;
    b.len = b.len + 1;
    return 0;
}

fn bytebuf_append(b as *ByteBuf, src as *u8, n as i64) as i64 {
    if (n <= 0) { return 0; }
    if (bytebuf_reserve(b, n) < 0) { return 0 - 1; }
    mem.core.memcpy(cast(*u8, cast(i64, b.ptr) + b.len), src, n);
    b.len = b.len + n;
    return 0;
}

fn bytebuf_reset(b as *ByteBuf) as void {
    b.len = 0;
}

fn bytebuf_free(b as *ByteBuf) as void {
    if (cast(i64, b.ptr) != 0) { _free(b.ptr); }
    b.ptr = cast(*u8, 0);
    b.len = 0;
    b.cap = 0;
}

// =======================================================
// caustic-unicode/utf/utf32.cst
// UTF-32 validation: each unit must be a scalar value (0..0x10FFFF,
// excluding surrogates).
// =======================================================

use "../core/errno.cst" as errno;

fn validate(cps as *i32, n as i64) as i64 {
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i32 as cp = cps[i];
        if (cp < 0 || cp > 1114111) { return 0 - errno.UERR_RANGE; }
        if (cp >= 55296 && cp <= 57343) { return 0 - errno.UERR_RANGE; }
        i = i + 1;
    }
    return 0;
}

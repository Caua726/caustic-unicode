// =======================================================
// caustic-unicode/width/width.cst
// Terminal/display column width. cp_width: 0 for control, format, and
// nonspacing/enclosing marks; 2 for Emoji_Presentation and for East-Asian
// Wide/Fullwidth; else 1.
//
// East_Asian_Width alone is not enough, and the gap is not a corner case.
// Regional indicators U+1F1E6..U+1F1FF are Neutral there, so a flag measured
// one column against a terminal drawing two, and every terminal checked drew
// two. Emoji_Presentation is the property that answers the question EAW was
// never asked — "is the default glyph the emoji one" — and it is consulted
// before EAW, never before the zero-width categories: a nonspacing mark does
// not advance the cursor whatever else is true of it.
//
// The other half of the same problem lives at cluster level, in cp_run_width:
// U+2764 and the keycap digits have no Emoji_Presentation, because on their own
// they are text. U+FE0F is what turns them into emoji, so a cluster in which
// VS16 selects emoji presentation is two columns whatever its base measures
// alone. See _emoji_presented for how narrowly that is scoped.
// =======================================================

use "../ucd/props.cst"            as props;
use "../ucd/tables/eaw.cst"       as eaw;
use "../ucd/tables/emojipres.cst" as emojipres;
use "../ucd/tables/extpict.cst"   as ep;
use "../utf/utf8.cst"             as utf8;
use "../core/buf.cst"             as buf;
use "../segment/grapheme.cst"     as gr;

// U+FE0F VARIATION SELECTOR-16, which requests emoji presentation.
let is i32 as VS16 with imut = 65039;

// U+20E3 COMBINING ENCLOSING KEYCAP, the third code point of a keycap.
let is i32 as KEYCAP with imut = 8419;

// Columns occupied by one code point: 0, 1, or 2.
fn cp_width(cp as i32) as i64 {
    let is i64 as gc = props.general_category(cp);
    if (gc == props.GC_CC || gc == props.GC_CF || gc == props.GC_MN || gc == props.GC_ME) { return 0; }
    if (emojipres.emojipres_get(cp) == 1) { return 2; }
    let is i64 as ea = props.east_asian_width(cp);
    if (ea == eaw.EAW_W || ea == eaw.EAW_F) { return 2; }
    return 1;
}

// Like cp_width, but East-Asian Ambiguous counts as 2 when ambiguous_wide=1
// (CJK legacy context); otherwise 1.
fn cp_width_amb(cp as i32, ambiguous_wide as i64) as i64 {
    let is i64 as w = cp_width(cp);
    if (ambiguous_wide == 1 && w == 1) {
        if (props.east_asian_width(cp) == eaw.EAW_A) { return 2; }
    }
    return w;
}

// 1 if cps[start..end) is an emoji presentation sequence — a base that VS16 has
// asked to be drawn as an emoji rather than as text (UTS #51).
//
// This is the half of the emoji width problem no per-code-point table can
// answer, which is why it lives at cluster level and not in cp_width. U+2764
// alone is a narrow dingbat and correctly has no Emoji_Presentation, because
// alone it is text; U+2764 U+FE0F is a red heart two cells wide. The keycaps are
// the same shape with an ASCII digit for a base, and the digits are not
// Extended_Pictographic either, so U+20E3 is what identifies them.
//
// The conditions are deliberately narrow. A bare VS16 stays 0 — it is Cf, and
// there is no emoji for it to be the presentation of. `A U+FE0F` stays 1: a
// variation selector on a Latin letter selects nothing.
fn _emoji_presented(cps as *i32, start as i64, end as i64) as i64 {
    let is i64 as vs with mut = 0;
    let is i64 as keycap with mut = 0;
    let is i64 as j with mut = start;
    while (j < end) {
        if (cps[j] == VS16)   { vs = 1; }
        if (cps[j] == KEYCAP) { keycap = 1; }
        j = j + 1;
    }
    if (vs == 0) { return 0; }
    if (keycap == 1) { return 1; }
    if (ep.extpict_get(cps[start]) == 1) { return 1; }
    return 0;
}

// Grapheme-cluster-aware run width: each cluster contributes the max cp_width
// of its members, so a base+combining sequence counts as the base and an
// emoji ZWJ sequence counts as 2 (not the sum of its parts) — or 2 outright when
// VS16 turned the cluster into an emoji.
fn cp_run_width(cps as *i32, n as i64) as i64 {
    let is i64 as total with mut = 0;
    let is gr.GraphemeIter as it = gr.grapheme_iter(cps, n);
    let is i64 as start with mut = 0;
    let is i64 as e with mut = gr.grapheme_next(&it);
    while (e >= 0) {
        let is i64 as w with mut = 0;
        let is i64 as j with mut = start;
        while (j < e) {
            let is i64 as cw = cp_width(cps[j]);
            if (cw > w) { w = cw; }
            j = j + 1;
        }
        if (w < 2 && _emoji_presented(cps, start, e) == 1) { w = 2; }
        total = total + w;
        start = e;
        e = gr.grapheme_next(&it);
    }
    return total;
}

// Display width of a UTF-8 string (grapheme-cluster aware). Returns >= 0, or
// 0 - UERR_* on bad UTF-8.
fn string_width(src as *u8, n as i64) as i64 {
    let is buf.CpBuf as cps = buf.cpbuf_new(64);
    if (utf8.to_cps(src, n, &cps) < 0) { buf.cpbuf_free(&cps); return 0 - 1; }
    let is i64 as w = cp_run_width(cps.ptr, cps.len);
    buf.cpbuf_free(&cps);
    return w;
}

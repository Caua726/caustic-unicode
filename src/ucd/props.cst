// =======================================================
// caustic-unicode/ucd/props.cst
// Public code-point property accessors over the generated tries.
// Total functions: out-of-range / unassigned code points return the
// property's default (e.g. GC_CN). No allocation, no errors.
// =======================================================

use "tables/gc.cst"     as gc;
use "tables/ccc.cst"    as ccc;
use "tables/script.cst" as scr;
use "tables/eaw.cst"    as eaw;
use "tables/lb.cst"     as lb;
use "tables/gcb.cst"    as gcb;
use "tables/wb.cst"     as wb;
use "tables/sb.cst"     as sb;
use "tables/bidi.cst"   as bidi;
use "tables/caseprops.cst" as cpr;

// General_Category values — MUST match tools/gen.cst:gc_id().
let is i64 as GC_CN with imut = 0;    // Unassigned (default)
let is i64 as GC_LU with imut = 1;    // Letter, uppercase
let is i64 as GC_LL with imut = 2;    // Letter, lowercase
let is i64 as GC_LT with imut = 3;    // Letter, titlecase
let is i64 as GC_LM with imut = 4;    // Letter, modifier
let is i64 as GC_LO with imut = 5;    // Letter, other
let is i64 as GC_MN with imut = 6;    // Mark, nonspacing
let is i64 as GC_MC with imut = 7;    // Mark, spacing combining
let is i64 as GC_ME with imut = 8;    // Mark, enclosing
let is i64 as GC_ND with imut = 9;    // Number, decimal digit
let is i64 as GC_NL with imut = 10;   // Number, letter
let is i64 as GC_NO with imut = 11;   // Number, other
let is i64 as GC_PC with imut = 12;   // Punctuation, connector
let is i64 as GC_PD with imut = 13;   // Punctuation, dash
let is i64 as GC_PS with imut = 14;   // Punctuation, open
let is i64 as GC_PE with imut = 15;   // Punctuation, close
let is i64 as GC_PI with imut = 16;   // Punctuation, initial quote
let is i64 as GC_PF with imut = 17;   // Punctuation, final quote
let is i64 as GC_PO with imut = 18;   // Punctuation, other
let is i64 as GC_SM with imut = 19;   // Symbol, math
let is i64 as GC_SC with imut = 20;   // Symbol, currency
let is i64 as GC_SK with imut = 21;   // Symbol, modifier
let is i64 as GC_SO with imut = 22;   // Symbol, other
let is i64 as GC_ZS with imut = 23;   // Separator, space
let is i64 as GC_ZL with imut = 24;   // Separator, line
let is i64 as GC_ZP with imut = 25;   // Separator, paragraph
let is i64 as GC_CC with imut = 26;   // Control
let is i64 as GC_CF with imut = 27;   // Format
let is i64 as GC_CS with imut = 28;   // Surrogate
let is i64 as GC_CO with imut = 29;   // Private use

// General_Category of a code point.
fn general_category(cp as i32) as i64 {
    return cast(i64, gc.gc_get(cp));
}

// 1 if cp is a letter (L*), else 0.
fn is_letter(cp as i32) as i64 {
    let is i64 as g = general_category(cp);
    if (g >= GC_LU && g <= GC_LO) { return 1; }
    return 0;
}

// 1 if cp is a decimal digit (Nd), else 0.
fn is_digit(cp as i32) as i64 {
    if (general_category(cp) == GC_ND) { return 1; }
    return 0;
}

// Canonical_Combining_Class (0..254). Value constants are the numbers.
fn combining_class(cp as i32) as i64 { return cast(i64, ccc.ccc_get(cp)); }

// Script id (see ucd/tables/script.cst SC_* constants).
fn script(cp as i32) as i64 { return cast(i64, scr.script_get(cp)); }

// East_Asian_Width id (EAW_* in ucd/tables/eaw.cst).
fn east_asian_width(cp as i32) as i64 { return cast(i64, eaw.eaw_get(cp)); }

// Line_Break id (LB_* in ucd/tables/lb.cst).
fn line_break(cp as i32) as i64 { return cast(i64, lb.lb_get(cp)); }

// Grapheme_Cluster_Break id (GCB_* in ucd/tables/gcb.cst).
fn grapheme_break(cp as i32) as i64 { return cast(i64, gcb.gcb_get(cp)); }

// Word_Break id (WB_* in ucd/tables/wb.cst).
fn word_break(cp as i32) as i64 { return cast(i64, wb.wb_get(cp)); }

// Sentence_Break id (SB_* in ucd/tables/sb.cst).
fn sentence_break(cp as i32) as i64 { return cast(i64, sb.sb_get(cp)); }

// Bidi_Class id (BIDI_* in ucd/tables/bidi.cst).
fn bidi_class(cp as i32) as i64 { return cast(i64, bidi.bidi_get(cp)); }

// Case-related binary properties (used by the case module's context rules).
fn is_cased(cp as i32) as i64          { if ((cpr.caseprops_get(cp) & 1) != 0) { return 1; } return 0; }
fn is_case_ignorable(cp as i32) as i64 { if ((cpr.caseprops_get(cp) & 2) != 0) { return 1; } return 0; }
fn is_soft_dotted(cp as i32) as i64    { if ((cpr.caseprops_get(cp) & 4) != 0) { return 1; } return 0; }

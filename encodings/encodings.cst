// =======================================================
// caustic-unicode/encodings/encodings.cst
// WHATWG legacy encodings. Single-byte codecs (windows-125x, ISO-8859-*,
// KOI8, IBM866, macintosh, windows-874, x-mac-cyrillic) are driven by the
// generated sbcs table. Multi-byte codecs are added below.
// Decoding maps unmapped bytes to U+FFFD; encoding errors on unmappable cps.
// =======================================================

use "../core/errno.cst"       as errno;
use "../core/buf.cst"         as buf;
use "../ucd/tables/sbcs.cst"  as sb;

let is i32 as U_REPL with imut = 65533;   // U+FFFD REPLACEMENT CHARACTER

// Decode single-byte bytes (encoding `enc`) into code points. Returns count.
fn sb_decode(enc as i32, src as *u8, n as i64, out as *buf.CpBuf) as i64 {
    let is i64 as base = out.len;
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i32 as b = cast(i32, src[i]);
        if (b < 128) { buf.cpbuf_push(out, b); }
        else {
            let is i32 as v = sb.sb_at(enc * 128 + (b - 128));
            if (v == 1114112) { buf.cpbuf_push(out, U_REPL); } else { buf.cpbuf_push(out, v); }
        }
        i = i + 1;
    }
    return out.len - base;
}

// Encode code points to single-byte (encoding `enc`). Returns byte count, or
// 0 - UERR_UNMAPPED if a code point has no byte in this encoding.
fn sb_encode(enc as i32, cps as *i32, n as i64, out as *buf.ByteBuf) as i64 {
    let is i64 as base = out.len;
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i32 as cp = cps[i];
        if (cp < 128) { buf.bytebuf_push(out, cast(u8, cp)); }
        else {
            let is i32 as b with mut = cast(i32, 0 - 1);
            let is i32 as k with mut = 0;
            while (k < 128) {
                if (sb.sb_at(enc * 128 + k) == cp) { b = 128 + k; k = 128; }
                else { k = k + 1; }
            }
            if (b < 0) { return 0 - errno.UERR_UNMAPPED; }
            buf.bytebuf_push(out, cast(u8, b));
        }
        i = i + 1;
    }
    return out.len - base;
}

use "../ucd/tables/mbcs.cst" as mb;

// ---- multi-byte decoders (WHATWG). Unmapped/invalid -> U+FFFD. ----

fn _emit(out as *buf.CpBuf, v as i32) as void {
    if (v == 1114112) { buf.cpbuf_push(out, U_REPL); } else { buf.cpbuf_push(out, v); }
}

// Big5 (lead 0x81-0xFE). Pointers 1133/1135/1164/1166 expand to two cps.
fn big5_decode(src as *u8, n as i64, out as *buf.CpBuf) as i64 {
    let is i64 as base = out.len;
    let is i32 as lead with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i32 as b = cast(i32, src[i]);
        if (lead != 0) {
            let is i32 as l = lead; lead = 0;
            let is i32 as off with mut = 98;
            if (b < 127) { off = 64; }
            if ((b >= 64 && b <= 126) || (b >= 161 && b <= 254)) {
                let is i32 as ptr = (l - 129) * 157 + (b - off);
                if (ptr == 1133) { buf.cpbuf_push(out, 202); buf.cpbuf_push(out, 772); }
                else if (ptr == 1135) { buf.cpbuf_push(out, 202); buf.cpbuf_push(out, 780); }
                else if (ptr == 1164) { buf.cpbuf_push(out, 234); buf.cpbuf_push(out, 772); }
                else if (ptr == 1166) { buf.cpbuf_push(out, 234); buf.cpbuf_push(out, 780); }
                else if (ptr >= 0 && ptr < mb.mb_big5_n) { _emit(out, mb.mb_big5_at(ptr)); }
                else { buf.cpbuf_push(out, U_REPL); }
            } else {
                buf.cpbuf_push(out, U_REPL);
                if (b < 128) { i = i - 1; }     // reprocess ASCII byte
            }
        } else if (b < 128) { buf.cpbuf_push(out, b); }
        else if (b >= 129 && b <= 254) { lead = b; }
        else { buf.cpbuf_push(out, U_REPL); }
        i = i + 1;
    }
    return out.len - base;
}

// EUC-KR (lead 0x81-0xFE).
fn euckr_decode(src as *u8, n as i64, out as *buf.CpBuf) as i64 {
    let is i64 as base = out.len;
    let is i32 as lead with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i32 as b = cast(i32, src[i]);
        if (lead != 0) {
            let is i32 as l = lead; lead = 0;
            if (b >= 65 && b <= 254) {
                let is i32 as ptr = (l - 129) * 190 + (b - 65);
                if (ptr >= 0 && ptr < mb.mb_euckr_n) { _emit(out, mb.mb_euckr_at(ptr)); } else { buf.cpbuf_push(out, U_REPL); }
            } else { buf.cpbuf_push(out, U_REPL); if (b < 128) { i = i - 1; } }
        } else if (b < 128) { buf.cpbuf_push(out, b); }
        else if (b >= 129 && b <= 254) { lead = b; }
        else { buf.cpbuf_push(out, U_REPL); }
        i = i + 1;
    }
    return out.len - base;
}

// Shift_JIS (lead 0x81-0x9F/0xE0-0xFC; 0xA1-0xDF = halfwidth katakana).
fn sjis_decode(src as *u8, n as i64, out as *buf.CpBuf) as i64 {
    let is i64 as base = out.len;
    let is i32 as lead with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i32 as b = cast(i32, src[i]);
        if (lead != 0) {
            let is i32 as l = lead; lead = 0;
            let is i32 as off with mut = 65;
            if (b < 127) { off = 64; }
            let is i32 as la with mut = 193;
            if (l < 160) { la = 129; }
            if ((b >= 64 && b <= 126) || (b >= 128 && b <= 252)) {
                let is i32 as ptr = (l - la) * 188 + (b - off);
                if (ptr >= 8836 && ptr <= 10715) { buf.cpbuf_push(out, 57344 + ptr - 8836); }
                else if (ptr >= 0 && ptr < mb.mb_jis_n) { _emit(out, mb.mb_jis_at(ptr)); }
                else { buf.cpbuf_push(out, U_REPL); }
            } else { buf.cpbuf_push(out, U_REPL); if (b < 128) { i = i - 1; } }
        } else if (b <= 128) { buf.cpbuf_push(out, b); }
        else if (b >= 161 && b <= 223) { buf.cpbuf_push(out, 65377 + b - 161); }
        else if ((b >= 129 && b <= 159) || (b >= 224 && b <= 252)) { lead = b; }
        else { buf.cpbuf_push(out, U_REPL); }
        i = i + 1;
    }
    return out.len - base;
}

// gb18030 4-byte pointer -> cp via the range table.
fn _gb_range(ptr as i32) as i32 {
    if (ptr == 7457) { return 59335; }                       // U+E7C7
    if ((ptr > 39419 && ptr < 189000) || ptr > 1237575) { return 1114112; }
    let is i32 as lo with mut = 0;
    let is i32 as hi with mut = mb.mb_rng_n - 1;
    let is i32 as best with mut = 0;
    while (lo <= hi) {
        let is i32 as mid = (lo + hi) / 2;
        if (mb.mb_rp_at(mid) <= ptr) { best = mid; lo = mid + 1; } else { hi = mid - 1; }
    }
    return mb.mb_rc_at(best) + (ptr - mb.mb_rp_at(best));
}

// gb18030 (1-byte ASCII/0x80=euro; 2-byte; 4-byte via ranges).
fn gb18030_decode(src as *u8, n as i64, out as *buf.CpBuf) as i64 {
    let is i64 as base = out.len;
    let is i32 as b1 with mut = 0;
    let is i32 as b2 with mut = 0;
    let is i32 as b3 with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i32 as b = cast(i32, src[i]);
        if (b3 != 0) {
            if (b >= 48 && b <= 57) {
                let is i32 as ptr = ((b1 - 129) * 12600) + ((b2 - 48) * 1260) + ((b3 - 129) * 10) + (b - 48);
                _emit(out, _gb_range(ptr));
            } else { buf.cpbuf_push(out, U_REPL); }
            b1 = 0; b2 = 0; b3 = 0;
        } else if (b2 != 0) {
            if (b >= 129 && b <= 254) { b3 = b; } else { buf.cpbuf_push(out, U_REPL); b1 = 0; b2 = 0; }
        } else if (b1 != 0) {
            if (b >= 48 && b <= 57) { b2 = b; }
            else {
                let is i32 as l = b1; b1 = 0;
                let is i32 as off with mut = 65;
                if (b < 127) { off = 64; }
                if ((b >= 64 && b <= 126) || (b >= 128 && b <= 254)) {
                    let is i32 as ptr = (l - 129) * 190 + (b - off);
                    if (ptr >= 0 && ptr < mb.mb_gb_n) { _emit(out, mb.mb_gb_at(ptr)); } else { buf.cpbuf_push(out, U_REPL); }
                } else { buf.cpbuf_push(out, U_REPL); if (b < 128) { i = i - 1; } }
            }
        } else if (b < 128) { buf.cpbuf_push(out, b); }
        else if (b == 128) { buf.cpbuf_push(out, 8364); }
        else if (b >= 129 && b <= 254) { b1 = b; }
        else { buf.cpbuf_push(out, U_REPL); }
        i = i + 1;
    }
    return out.len - base;
}

// ---- reverse lookups (cp -> pointer) for encoding ----
fn _rev_jis(cp as i32) as i32 {
    let is i32 as lo with mut = 0; let is i32 as hi with mut = mb.mb_rj_n - 1;
    while (lo <= hi) { let is i32 as m = (lo + hi) / 2; let is i32 as v = mb.mb_rjc_at(m);
        if (v < cp) { lo = m + 1; } else if (v > cp) { hi = m - 1; } else { return mb.mb_rjp_at(m); } }
    return cast(i32, 0 - 1);
}
fn _rev_big5(cp as i32) as i32 {
    let is i32 as lo with mut = 0; let is i32 as hi with mut = mb.mb_rb_n - 1;
    while (lo <= hi) { let is i32 as m = (lo + hi) / 2; let is i32 as v = mb.mb_rbc_at(m);
        if (v < cp) { lo = m + 1; } else if (v > cp) { hi = m - 1; } else { return mb.mb_rbp_at(m); } }
    return cast(i32, 0 - 1);
}
fn _rev_euckr(cp as i32) as i32 {
    let is i32 as lo with mut = 0; let is i32 as hi with mut = mb.mb_rk_n - 1;
    while (lo <= hi) { let is i32 as m = (lo + hi) / 2; let is i32 as v = mb.mb_rkc_at(m);
        if (v < cp) { lo = m + 1; } else if (v > cp) { hi = m - 1; } else { return mb.mb_rkp_at(m); } }
    return cast(i32, 0 - 1);
}
fn _rev_gb(cp as i32) as i32 {
    let is i32 as lo with mut = 0; let is i32 as hi with mut = mb.mb_rg_n - 1;
    while (lo <= hi) { let is i32 as m = (lo + hi) / 2; let is i32 as v = mb.mb_rgc_at(m);
        if (v < cp) { lo = m + 1; } else if (v > cp) { hi = m - 1; } else { return mb.mb_rgp_at(m); } }
    return cast(i32, 0 - 1);
}

// ---- multi-byte encoders. Unmappable cp -> 0 - UERR_UNMAPPED. ----
fn big5_encode(cps as *i32, n as i64, out as *buf.ByteBuf) as i64 {
    let is i64 as base = out.len; let is i64 as i with mut = 0;
    while (i < n) { let is i32 as cp = cps[i];
        if (cp < 128) { buf.bytebuf_push(out, cast(u8, cp)); }
        else { let is i32 as p = _rev_big5(cp); if (p < 0) { return 0 - errno.UERR_UNMAPPED; }
            let is i32 as tr with mut = p % 157; if (tr < 63) { tr = tr + 64; } else { tr = tr + 98; }
            buf.bytebuf_push(out, cast(u8, p / 157 + 129)); buf.bytebuf_push(out, cast(u8, tr)); }
        i = i + 1; }
    return out.len - base;
}
fn euckr_encode(cps as *i32, n as i64, out as *buf.ByteBuf) as i64 {
    let is i64 as base = out.len; let is i64 as i with mut = 0;
    while (i < n) { let is i32 as cp = cps[i];
        if (cp < 128) { buf.bytebuf_push(out, cast(u8, cp)); }
        else { let is i32 as p = _rev_euckr(cp); if (p < 0) { return 0 - errno.UERR_UNMAPPED; }
            buf.bytebuf_push(out, cast(u8, p / 190 + 129)); buf.bytebuf_push(out, cast(u8, p % 190 + 65)); }
        i = i + 1; }
    return out.len - base;
}
fn sjis_encode(cps as *i32, n as i64, out as *buf.ByteBuf) as i64 {
    let is i64 as base = out.len; let is i64 as i with mut = 0;
    while (i < n) { let is i32 as cp = cps[i];
        if (cp <= 128) { buf.bytebuf_push(out, cast(u8, cp)); }
        else if (cp == 165) { buf.bytebuf_push(out, cast(u8, 92)); }            // YEN -> 0x5C
        else if (cp == 8254) { buf.bytebuf_push(out, cast(u8, 126)); }          // OVERLINE -> 0x7E
        else if (cp >= 65377 && cp <= 65439) { buf.bytebuf_push(out, cast(u8, cp - 65377 + 161)); }  // katakana
        else { let is i32 as p = _rev_jis(cp); if (p < 0) { return 0 - errno.UERR_UNMAPPED; }
            let is i32 as l with mut = p / 188; if (l < 31) { l = l + 129; } else { l = l + 193; }
            let is i32 as tr with mut = p % 188; if (tr < 63) { tr = tr + 64; } else { tr = tr + 65; }
            buf.bytebuf_push(out, cast(u8, l)); buf.bytebuf_push(out, cast(u8, tr)); }
        i = i + 1; }
    return out.len - base;
}
fn _gb_range_encode(cp as i32) as i32 {
    let is i32 as lo with mut = 0; let is i32 as hi with mut = mb.mb_rng_n - 1; let is i32 as best with mut = 0;
    while (lo <= hi) { let is i32 as m = (lo + hi) / 2; if (mb.mb_rc_at(m) <= cp) { best = m; lo = m + 1; } else { hi = m - 1; } }
    return mb.mb_rp_at(best) + (cp - mb.mb_rc_at(best));
}
fn gb18030_encode(cps as *i32, n as i64, out as *buf.ByteBuf) as i64 {
    let is i64 as base = out.len; let is i64 as i with mut = 0;
    while (i < n) { let is i32 as cp = cps[i];
        if (cp < 128) { buf.bytebuf_push(out, cast(u8, cp)); }
        else if (cp == 58853) { return 0 - errno.UERR_UNMAPPED; }               // U+E5E5
        else { let is i32 as p = _rev_gb(cp);
            if (p >= 0) {
                let is i32 as tr with mut = p % 190; if (tr < 63) { tr = tr + 64; } else { tr = tr + 65; }
                buf.bytebuf_push(out, cast(u8, p / 190 + 129)); buf.bytebuf_push(out, cast(u8, tr));
            } else {
                let is i32 as p4 with mut = _gb_range_encode(cp);
                let is i32 as b1 = p4 / 12600; p4 = p4 % 12600;
                let is i32 as b2 = p4 / 1260; p4 = p4 % 1260;
                let is i32 as b3 = p4 / 10; let is i32 as b4 = p4 % 10;
                buf.bytebuf_push(out, cast(u8, b1 + 129)); buf.bytebuf_push(out, cast(u8, b2 + 48));
                buf.bytebuf_push(out, cast(u8, b3 + 129)); buf.bytebuf_push(out, cast(u8, b4 + 48));
            } }
        i = i + 1; }
    return out.len - base;
}

// ---- EUC-JP (jis0208 + 0x8E katakana + 0x8F jis0212) ----
fn eucjp_decode(src as *u8, n as i64, out as *buf.CpBuf) as i64 {
    let is i64 as base = out.len; let is i32 as lead with mut = 0; let is i32 as f212 with mut = 0; let is i64 as i with mut = 0;
    while (i < n) { let is i32 as b = cast(i32, src[i]);
        if (lead == 142) { lead = 0; if (b >= 161 && b <= 223) { buf.cpbuf_push(out, 65377 + b - 161); } else { buf.cpbuf_push(out, U_REPL); if (b < 128) { i = i - 1; } } }
        else if (lead == 143) { if (b >= 161 && b <= 254) { lead = b; f212 = 1; } else { lead = 0; buf.cpbuf_push(out, U_REPL); if (b < 128) { i = i - 1; } } }
        else if (lead != 0) { let is i32 as l = lead; lead = 0;
            if (b >= 161 && b <= 254) { let is i32 as ptr = (l - 161) * 94 + (b - 161);
                if (f212 == 1) { f212 = 0; if (ptr >= 0 && ptr < mb.mb_jis212_n) { _emit(out, mb.mb_jis212_at(ptr)); } else { buf.cpbuf_push(out, U_REPL); } }
                else { if (ptr >= 0 && ptr < mb.mb_jis_n) { _emit(out, mb.mb_jis_at(ptr)); } else { buf.cpbuf_push(out, U_REPL); } } }
            else { f212 = 0; buf.cpbuf_push(out, U_REPL); if (b < 128) { i = i - 1; } } }
        else if (b < 128) { buf.cpbuf_push(out, b); }
        else if (b == 142 || b == 143) { lead = b; }
        else if (b >= 161 && b <= 254) { lead = b; }
        else { buf.cpbuf_push(out, U_REPL); }
        i = i + 1; }
    return out.len - base;
}
fn eucjp_encode(cps as *i32, n as i64, out as *buf.ByteBuf) as i64 {
    let is i64 as base = out.len; let is i64 as i with mut = 0;
    while (i < n) { let is i32 as cp = cps[i];
        if (cp < 128) { buf.bytebuf_push(out, cast(u8, cp)); }
        else if (cp == 165) { buf.bytebuf_push(out, cast(u8, 92)); }
        else if (cp == 8254) { buf.bytebuf_push(out, cast(u8, 126)); }
        else if (cp >= 65377 && cp <= 65439) { buf.bytebuf_push(out, cast(u8, 142)); buf.bytebuf_push(out, cast(u8, cp - 65377 + 161)); }
        else { let is i32 as p = _rev_jis(cp); if (p < 0) { return 0 - errno.UERR_UNMAPPED; }
            buf.bytebuf_push(out, cast(u8, p / 94 + 161)); buf.bytebuf_push(out, cast(u8, p % 94 + 161)); }
        i = i + 1; }
    return out.len - base;
}

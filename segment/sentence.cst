// =======================================================
// caustic-unicode/segment/sentence.cst
// Sentence boundaries (UAX #29, rules SB1-SB998). SB5 folds Extend/Format
// into the preceding character. The terminator rules (SB8-SB11) look back
// over an "(ATerm|STerm) Close* Sp*" sequence and SB8 looks ahead for a
// lowercase letter. Operates on a code-point run.
// =======================================================

use "../core/errno.cst"      as errno;
use "../ucd/tables/sb.cst"   as sb;

struct SentenceIter { cps as *i32; n as i64; pos as i64; }

fn sentence_iter(cps as *i32, n as i64) as SentenceIter {
    let is SentenceIter as it;
    it.cps = cps; it.n = n; it.pos = 0;
    return it;
}

fn _p(cp as i32) as i64 { return cast(i64, sb.sb_get(cp)); }

fn _sig(x as i64) as i64 {
    if (x == sb.SB_Extend || x == sb.SB_Format) { return 0; }
    return 1;
}
fn _prev_sig(cps as *i32, i as i64) as i64 {
    let is i64 as j with mut = i - 1;
    while (j >= 0 && _sig(_p(cps[j])) == 0) { j = j - 1; }
    return j;
}

// SB8: from index i, skipping Extend/Format and "neutral" chars, is the next
// stop-class char a Lower? (stop = OLetter|Upper|Lower|Sep|CR|LF|STerm|ATerm)
fn _sb8_lower_ahead(cps as *i32, n as i64, i as i64) as i64 {
    let is i64 as j with mut = i;
    while (j < n) {
        let is i64 as pj = _p(cps[j]);
        if (pj == sb.SB_Lower) { return 1; }
        if (pj == sb.SB_OLetter || pj == sb.SB_Upper || pj == sb.SB_Sep
            || pj == sb.SB_CR || pj == sb.SB_LF || pj == sb.SB_STerm || pj == sb.SB_ATerm) { return 0; }
        j = j + 1;
    }
    return 0;
}

// 1 if there is a sentence boundary between cps[i-1] and cps[i].
fn _boundary(cps as *i32, n as i64, i as i64) as i64 {
    let is i64 as prev = _p(cps[i - 1]);
    let is i64 as cur  = _p(cps[i]);

    if (prev == sb.SB_CR && cur == sb.SB_LF) { return 0; }                              // SB3
    if (prev == sb.SB_Sep || prev == sb.SB_CR || prev == sb.SB_LF) { return 1; }        // SB4
    if (cur == sb.SB_Extend || cur == sb.SB_Format) { return 0; }                       // SB5

    let is i64 as ai = _prev_sig(cps, i);
    if (ai < 0) { return 0; }
    let is i64 as a = _p(cps[ai]);
    let is i64 as b = cur;

    if (a == sb.SB_ATerm && b == sb.SB_Numeric) { return 0; }                           // SB6
    if (a == sb.SB_ATerm && b == sb.SB_Upper) {                                         // SB7
        let is i64 as aai = _prev_sig(cps, ai);
        if (aai >= 0) {
            let is i64 as aa = _p(cps[aai]);
            if (aa == sb.SB_Upper || aa == sb.SB_Lower) { return 0; }
        }
    }

    // Terminator context: scan back over Sp* then Close* to an ATerm/STerm.
    let is i64 as j with mut = ai;
    let is i64 as nsp with mut = 0;
    while (j >= 0 && _p(cps[j]) == sb.SB_Sp) { nsp = nsp + 1; j = _prev_sig(cps, j); }
    while (j >= 0 && _p(cps[j]) == sb.SB_Close) { j = _prev_sig(cps, j); }
    let is i64 as term with mut = sb.SB_Other;
    if (j >= 0) { term = _p(cps[j]); }

    if (term == sb.SB_ATerm || term == sb.SB_STerm) {
        if (term == sb.SB_ATerm && _sb8_lower_ahead(cps, n, i) == 1) { return 0; }      // SB8
        if (b == sb.SB_SContinue || b == sb.SB_STerm || b == sb.SB_ATerm) { return 0; }    // SB8a
        if (nsp == 0 && (b == sb.SB_Close || b == sb.SB_Sp || b == sb.SB_Sep || b == sb.SB_CR || b == sb.SB_LF)) { return 0; }  // SB9
        if (b == sb.SB_Sp || b == sb.SB_Sep || b == sb.SB_CR || b == sb.SB_LF) { return 0; }   // SB10
        return 1;                                                                       // SB11
    }

    return 0;                                                                           // SB998
}

fn sentence_next(it as *SentenceIter) as i64 {
    if (it.pos >= it.n) { return 0 - errno.UERR_END; }
    let is i64 as p with mut = it.pos + 1;
    while (p < it.n && _boundary(it.cps, it.n, p) == 0) { p = p + 1; }
    it.pos = p;
    return p;
}

fn sentence_is_boundary(cps as *i32, n as i64, i as i64) as i64 {
    if (i <= 0 || i >= n) { return 1; }
    return _boundary(cps, n, i);
}

fn sentence_count(cps as *i32, n as i64) as i64 {
    let is SentenceIter as it = sentence_iter(cps, n);
    let is i64 as c with mut = 0;
    while (sentence_next(&it) >= 0) { c = c + 1; }
    return c;
}

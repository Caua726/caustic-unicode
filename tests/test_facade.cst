// Compiling this type-checks the entire library (the umbrella `use`s every
// module); running it confirms the whole thing links. Exit 0 = ok.
use "../src/caustic_unicode.cst" as u;

fn main() as i32 {
    let is *u8 as v = u.version();   // force the facade (and all modules) to link
    if (v[0] == 0) { return 1; }
    return 0;
}

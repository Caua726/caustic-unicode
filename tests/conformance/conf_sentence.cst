// =======================================================
// tests/conformance/conf_sentence.cst
// Runs the official SentenceBreakTest.txt (16.0). Lines use ÷ (boundary)
// and × (no boundary) between code points; we compare every interior
// position against grapheme_is_boundary. Exit 0 = all pass.
// =======================================================

use "std/io.cst"  as io;
use "std/mem.cst" only bins, core as mem;
use "../../segment/sentence.cst" as se;
use "../../core/buf.cst"         as buf;

fn slurp(path as *u8, out_len as *i32) as *u8 {
    let is i64 as fd = io._open_read(path);
    if (fd < 0) { return cast(*u8, 0); }
    let is i64 as size = io._lseek(fd, 0, io._SEEK_END);
    io._lseek(fd, 0, io._SEEK_SET);
    if (size <= 0) { io._close_fd(fd); return cast(*u8, 0); }
    let is *u8 as b = mem.core.mmap_anon(size + 1);
    io.read_exact(fd, b, size);
    io._close_fd(fd);
    out_len[0] = cast(i32, size);
    return b;
}

fn line_end(p as *u8, len as i32, pos as i32) as i32 {
    let is i32 as i with mut = pos;
    while (i < len) { if (p[i] == 10) { return i; } i = i + 1; }
    return len;
}

fn hexval(c as u8) as i32 {
    if (c >= 48 && c <= 57)  { return cast(i32, c) - 48; }
    if (c >= 65 && c <= 70)  { return cast(i32, c) - 55; }
    if (c >= 97 && c <= 102) { return cast(i32, c) - 87; }
    return cast(i32, 0 - 1);
}

fn main() as i32 {
    let is i32 as len with mut = 0;
    let is *u8 as p = slurp("tests/vectors/SentenceBreakTest.txt", &len);
    if (cast(i64, p) == 0) { io.write_str(1, "cannot read SentenceBreakTest.txt\n"); return 99; }

    let is buf.CpBuf as cps = buf.cpbuf_new(64);
    let is [256]i64 as bnd;          // bnd[k] = expected boundary before cps[k]

    let is i32 as lineno with mut = 0;
    let is i32 as pos with mut = 0;
    while (pos < len) {
        lineno = lineno + 1;
        let is i32 as le = line_end(p, len, pos);
        let is i32 as llen = le - pos;
        if (llen > 0) {
            let is *u8 as lp = cast(*u8, cast(i64, p) + pos);
            if (lp[0] != 35) {                                  // skip comments
                buf.cpbuf_reset(&cps);
                let is i64 as nb with mut = 0;
                let is i32 as last_break with mut = 1;          // marker before the next cp
                let is i32 as q with mut = 0;
                let is i32 as ok with mut = 1;
                while (q < llen && ok == 1) {
                    if (lp[q] == 35) { q = llen; }              // start of comment
                    else if (lp[q] == 32 || lp[q] == 9) { q = q + 1; }
                    else if (lp[q] == 195 && q + 1 < llen && lp[q + 1] == 183) { last_break = 1; q = q + 2; }   // ÷
                    else if (lp[q] == 195 && q + 1 < llen && lp[q + 1] == 151) { last_break = 0; q = q + 2; }   // ×
                    else {
                        let is i32 as ts = q;
                        while (q < llen && lp[q] != 32 && lp[q] != 9) { q = q + 1; }
                        let is i32 as v with mut = 0;
                        let is i32 as k with mut = ts;
                        while (k < q) {
                            let is i32 as d = hexval(lp[k]);
                            if (d < 0) { ok = 0; }
                            v = (v << 4) | d;
                            k = k + 1;
                        }
                        if (ok == 1) {
                            buf.cpbuf_push(&cps, v);
                            if (nb < 256) { bnd[nb] = cast(i64, last_break); }
                            nb = nb + 1;
                        }
                    }
                }
                if (ok == 1 && cps.len >= 1) {
                    let is i64 as i with mut = 1;
                    while (i < cps.len) {
                        if (se.sentence_is_boundary(cps.ptr, cps.len, i) != bnd[i]) {
                            io.write_str(1, "FAIL line "); io.write_int(1, cast(i64, lineno));
                            io.write_str(1, " at "); io.write_int(1, i); io.write_str(1, "\n");
                            return 1;
                        }
                        i = i + 1;
                    }
                }
            }
        }
        pos = le + 1;
    }
    io.write_str(1, "conf_sentence: all lines pass\n");
    return 0;
}

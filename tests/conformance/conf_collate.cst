// =======================================================
// tests/conformance/conf_collate.cst
// Runs the official UCA CollationTest (16.0): each line's cps must sort
// >= the previous line's under the DUCET. NON_IGNORABLE and SHIFTED
// variable-weighting variants. Exit 0 = all pass.
// =======================================================

use "std/io.cst"  as io;
use "std/mem.cst" only bins, core as mem;
use "../../src/collate/collate.cst" as co;
use "../../src/core/buf.cst"        as buf;

fn slurp(path as *u8, out_len as *i32) as *u8 {
    let is i64 as fd = io._open_read(path);
    if (fd < 0) { return cast(*u8, 0); }
    let is i64 as size = io._lseek(fd, 0, io._SEEK_END);
    io._lseek(fd, 0, io._SEEK_SET);
    if (size <= 0) { io._close_fd(fd); return cast(*u8, 0); }
    let is *u8 as b = mem.core.mmap_anon(size + 1);
    io.read_exact(fd, b, size);
    io._close_fd(fd);
    out_len[0] = cast(i32, size);
    return b;
}
fn line_end(p as *u8, len as i32, pos as i32) as i32 {
    let is i32 as i with mut = pos;
    while (i < len) { if (p[i] == 10) { return i; } i = i + 1; }
    return len;
}
fn hexval(c as u8) as i32 {
    if (c >= 48 && c <= 57)  { return cast(i32, c) - 48; }
    if (c >= 65 && c <= 70)  { return cast(i32, c) - 55; }
    if (c >= 97 && c <= 102) { return cast(i32, c) - 87; }
    return cast(i32, 0 - 1);
}

// Returns 0 ok, or the failing line number.
fn run_file(path as *u8, mode as i64) as i64 {
    let is i32 as len with mut = 0;
    let is *u8 as p = slurp(path, &len);
    if (cast(i64, p) == 0) { io.write_str(1, "cannot read "); io.write_str(1, path); io.write_str(1, "\n"); return 0 - 99; }

    let is buf.CpBuf as cps  = buf.cpbuf_new(32);
    let is buf.CpBuf as prev = buf.cpbuf_new(32);
    let is buf.CpBuf as cur  = buf.cpbuf_new(32);
    let is i64 as have_prev with mut = 0;
    let is i32 as lineno with mut = 0;
    let is i32 as pos with mut = 0;
    while (pos < len) {
        lineno = lineno + 1;
        let is i32 as le = line_end(p, len, pos);
        let is i32 as llen = le - pos;
        if (llen > 0) {
            let is *u8 as lp = cast(*u8, cast(i64, p) + pos);
            if (lp[0] != 35 && lp[0] != 64) {              // skip '#' and '@'
                buf.cpbuf_reset(&cps);
                let is i32 as q with mut = 0;
                let is i32 as ok with mut = 1;
                while (q < llen && lp[q] != 59) {          // up to ';'
                    while (q < llen && lp[q] != 59 && (lp[q] == 32 || lp[q] == 9)) { q = q + 1; }
                    let is i32 as ts = q;
                    while (q < llen && lp[q] != 59 && lp[q] != 32 && lp[q] != 9) { q = q + 1; }
                    if (q > ts) {
                        let is i32 as v with mut = 0;
                        let is i32 as k with mut = ts;
                        while (k < q) { let is i32 as d = hexval(lp[k]); if (d < 0) { ok = 0; } v = (v << 4) | d; k = k + 1; }
                        if (ok == 1) { buf.cpbuf_push(&cps, v); }
                    }
                }
                if (ok == 1 && cps.len >= 1) {
                    buf.cpbuf_reset(&cur);
                    co.sort_key(cps.ptr, cps.len, mode, &cur);
                    if (have_prev == 1) {
                        if (co._key_cmp(&prev, &cur) > 0) { return cast(i64, lineno); }
                    }
                    buf.cpbuf_reset(&prev);
                    buf.cpbuf_append(&prev, cur.ptr, cur.len);
                    have_prev = 1;
                }
            }
        }
        pos = le + 1;
    }
    return 0;
}

fn main() as i32 {
    let is i64 as r1 = run_file("tests/vectors/CollationTest_NON_IGNORABLE.txt", 0);
    if (r1 != 0) { io.write_str(1, "FAIL NON_IGNORABLE line "); io.write_int(1, r1); io.write_str(1, "\n"); return 1; }
    let is i64 as r2 = run_file("tests/vectors/CollationTest_SHIFTED.txt", 1);
    if (r2 != 0) { io.write_str(1, "FAIL SHIFTED line "); io.write_int(1, r2); io.write_str(1, "\n"); return 2; }
    io.write_str(1, "conf_collate: all lines pass\n");
    return 0;
}

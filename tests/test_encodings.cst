// =======================================================
// tests/test_encodings.cst — WHATWG single-byte codecs (curated vectors +
// round-trips). Exit 0 = pass; non-zero = the numbered check that failed.
// =======================================================

use "../src/encodings/encodings.cst" as enc;
use "../src/ucd/tables/sbcs.cst"      as sb;
use "../src/core/buf.cst"            as buf;

fn main() as i32 {
    let is buf.CpBuf as o = buf.cpbuf_new(16);

    // windows-1252: 0x80 -> EURO (U+20AC), 0xA9 -> COPYRIGHT (U+00A9)
    let is [2]u8 as w; w[0] = 128; w[1] = 169;
    buf.cpbuf_reset(&o); enc.sb_decode(sb.ENC_WINDOWS_1252, cast(*u8, &w), 2, &o);
    if (o.len != 2 || o.ptr[0] != 8364 || o.ptr[1] != 169) { return 1; }

    // ISO-8859-15: 0xA4 -> EURO
    let is [1]u8 as a; a[0] = 164;
    buf.cpbuf_reset(&o); enc.sb_decode(sb.ENC_ISO_8859_15, cast(*u8, &a), 1, &o);
    if (o.len != 1 || o.ptr[0] != 8364) { return 2; }

    // windows-1251: 0xC0 -> CYRILLIC CAPITAL A (U+0410)
    let is [1]u8 as c; c[0] = 192;
    buf.cpbuf_reset(&o); enc.sb_decode(sb.ENC_WINDOWS_1251, cast(*u8, &c), 1, &o);
    if (o.len != 1 || o.ptr[0] != 1040) { return 3; }

    // ASCII passthrough
    let is [3]u8 as asc; asc[0] = 65; asc[1] = 66; asc[2] = 67;
    buf.cpbuf_reset(&o); enc.sb_decode(sb.ENC_WINDOWS_1252, cast(*u8, &asc), 3, &o);
    if (o.len != 3 || o.ptr[0] != 65 || o.ptr[2] != 67) { return 4; }

    // encode: EURO -> 0x80 in windows-1252, 0xA4 in iso-8859-15
    let is buf.ByteBuf as b = buf.bytebuf_new(16);
    let is [1]i32 as euro; euro[0] = 8364;
    buf.bytebuf_reset(&b); enc.sb_encode(sb.ENC_WINDOWS_1252, cast(*i32, &euro), 1, &b);
    if (b.len != 1 || b.ptr[0] != 128) { return 5; }
    buf.bytebuf_reset(&b); enc.sb_encode(sb.ENC_ISO_8859_15, cast(*i32, &euro), 1, &b);
    if (b.len != 1 || b.ptr[0] != 164) { return 6; }

    // unmappable -> error (CJK in windows-1252)
    let is [1]i32 as han; han[0] = 20013;
    buf.bytebuf_reset(&b);
    if (enc.sb_encode(sb.ENC_WINDOWS_1252, cast(*i32, &han), 1, &b) >= 0) { return 7; }

    // round-trip windows-1251 full high range
    let is i32 as bb with mut = 128;
    while (bb < 256) {
        let is [1]u8 as one; one[0] = cast(u8, bb);
        buf.cpbuf_reset(&o); enc.sb_decode(sb.ENC_WINDOWS_1251, cast(*u8, &one), 1, &o);
        if (o.ptr[0] != 65533) {                      // skip unmapped
            buf.bytebuf_reset(&b); enc.sb_encode(sb.ENC_WINDOWS_1251, o.ptr, 1, &b);
            if (b.len != 1 || cast(i32, b.ptr[0]) != bb) { return 8; }
        }
        bb = bb + 1;
    }

    // Shift_JIS: halfwidth katakana 0xB1 -> U+FF71; あ 0x82 0xA0 -> U+3042
    let is [1]u8 as sj1; sj1[0] = 177;
    buf.cpbuf_reset(&o); enc.sjis_decode(cast(*u8, &sj1), 1, &o);
    if (o.len != 1 || o.ptr[0] != 65393) { return 9; }
    let is [2]u8 as sj2; sj2[0] = 130; sj2[1] = 160;
    buf.cpbuf_reset(&o); enc.sjis_decode(cast(*u8, &sj2), 2, &o);
    if (o.len != 1 || o.ptr[0] != 12354) { return 10; }

    // Big5: 一 (U+4E00) = 0xA4 0x40
    let is [2]u8 as bg; bg[0] = 164; bg[1] = 64;
    buf.cpbuf_reset(&o); enc.big5_decode(cast(*u8, &bg), 2, &o);
    if (o.len != 1 || o.ptr[0] != 19968) { return 11; }

    // EUC-KR: 가 (U+AC00) = 0xB0 0xA1
    let is [2]u8 as ek; ek[0] = 176; ek[1] = 161;
    buf.cpbuf_reset(&o); enc.euckr_decode(cast(*u8, &ek), 2, &o);
    if (o.len != 1 || o.ptr[0] != 44032) { return 12; }

    // gb18030: euro 0x80; 2-byte 一 0xD2 0xBB; 4-byte 0x81 0x30 0x81 0x30 -> U+0080
    let is [1]u8 as gbe; gbe[0] = 128;
    buf.cpbuf_reset(&o); enc.gb18030_decode(cast(*u8, &gbe), 1, &o);
    if (o.len != 1 || o.ptr[0] != 8364) { return 13; }
    let is [2]u8 as gb2; gb2[0] = 210; gb2[1] = 187;
    buf.cpbuf_reset(&o); enc.gb18030_decode(cast(*u8, &gb2), 2, &o);
    if (o.len != 1 || o.ptr[0] != 19968) { return 14; }
    let is [4]u8 as gb4; gb4[0] = 129; gb4[1] = 48; gb4[2] = 129; gb4[3] = 48;
    buf.cpbuf_reset(&o); enc.gb18030_decode(cast(*u8, &gb4), 4, &o);
    if (o.len != 1 || o.ptr[0] != 128) { return 15; }

    // multi-byte encode + round-trip
    let is [1]i32 as t;
    t[0] = 19968;  // 一  Big5 round-trip
    buf.bytebuf_reset(&b); enc.big5_encode(cast(*i32, &t), 1, &b);
    buf.cpbuf_reset(&o); enc.big5_decode(b.ptr, b.len, &o);
    if (o.len != 1 || o.ptr[0] != 19968) { return 16; }

    t[0] = 44032;  // 가  EUC-KR round-trip
    buf.bytebuf_reset(&b); enc.euckr_encode(cast(*i32, &t), 1, &b);
    buf.cpbuf_reset(&o); enc.euckr_decode(b.ptr, b.len, &o);
    if (o.len != 1 || o.ptr[0] != 44032) { return 17; }

    t[0] = 12354;  // あ  Shift_JIS round-trip
    buf.bytebuf_reset(&b); enc.sjis_encode(cast(*i32, &t), 1, &b);
    buf.cpbuf_reset(&o); enc.sjis_decode(b.ptr, b.len, &o);
    if (o.len != 1 || o.ptr[0] != 12354) { return 18; }
    t[0] = 65393;  // halfwidth katakana ｱ
    buf.bytebuf_reset(&b); enc.sjis_encode(cast(*i32, &t), 1, &b);
    if (b.len != 1 || b.ptr[0] != 177) { return 19; }

    t[0] = 19968;  // 一  gb18030 2-byte round-trip
    buf.bytebuf_reset(&b); enc.gb18030_encode(cast(*i32, &t), 1, &b);
    buf.cpbuf_reset(&o); enc.gb18030_decode(b.ptr, b.len, &o);
    if (o.len != 1 || o.ptr[0] != 19968) { return 20; }
    t[0] = 128512;  // 😀  gb18030 4-byte round-trip
    buf.bytebuf_reset(&b); enc.gb18030_encode(cast(*i32, &t), 1, &b);
    if (b.len != 4) { return 21; }
    buf.cpbuf_reset(&o); enc.gb18030_decode(b.ptr, b.len, &o);
    if (o.len != 1 || o.ptr[0] != 128512) { return 22; }

    t[0] = 12354;  // あ  EUC-JP round-trip
    buf.bytebuf_reset(&b); enc.eucjp_encode(cast(*i32, &t), 1, &b);
    buf.cpbuf_reset(&o); enc.eucjp_decode(b.ptr, b.len, &o);
    if (o.len != 1 || o.ptr[0] != 12354) { return 23; }

    buf.cpbuf_free(&o); buf.bytebuf_free(&b);
    return 0;
}

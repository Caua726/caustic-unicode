// =======================================================
// tests/test_ucd.cst — validates the generated General_Category trie:
// UnicodeData -> tools/gen -> \xNN blob -> trie.lookup2 -> property.
// Includes a First/Last range (CJK), a supplementary-plane cp (emoji),
// and the last (unassigned) code point.
// Exit 0 = all pass; non-zero = the numbered check that failed.
// =======================================================

use "../src/ucd/props.cst"        as props;
use "../src/ucd/tables/script.cst" as scr;
use "../src/ucd/tables/eaw.cst"    as eaw;
use "../src/ucd/tables/bidi.cst"   as bidi;
use "../src/ucd/tables/gcb.cst"    as gcb;
use "../src/ucd/tables/isc.cst"    as isc;
use "../src/ucd/tables/ipc.cst"    as ipc;

fn main() as i32 {
    // Indic_Syllabic_Category and Indic_Positional_Category.
    if (props.indic_syllabic_category(2325) != isc.ISC_Consonant) { return 201; }           // U+0915 KA
    if (props.indic_syllabic_category(2381) != isc.ISC_Virama) { return 202; }              // U+094D
    if (props.indic_syllabic_category(2364) != isc.ISC_Nukta) { return 203; }               // U+093C
    if (props.indic_syllabic_category(2366) != isc.ISC_Vowel_Dependent) { return 204; }     // U+093E AA
    if (props.indic_syllabic_category(2308) != isc.ISC_Vowel_Independent) { return 205; }   // U+0904
    if (props.indic_syllabic_category(2306) != isc.ISC_Bindu) { return 206; }               // U+0902
    if (props.indic_syllabic_category(8205) != isc.ISC_Joiner) { return 207; }              // U+200D
    if (props.indic_syllabic_category(8204) != isc.ISC_Non_Joiner) { return 208; }          // U+200C
    if (props.indic_syllabic_category(65)   != isc.ISC_Other) { return 209; }               // 'A'
    if (props.indic_syllabic_category(1114111) != isc.ISC_Other) { return 210; }
    if (props.indic_syllabic_category(69688) != isc.ISC_Vowel_Dependent) { return 211; }    // U+11038 Brahmi, past the BMP
    if (props.indic_positional_category(2367) != ipc.IPC_Left) { return 220; }              // U+093F I
    if (props.indic_positional_category(2366) != ipc.IPC_Right) { return 221; }             // U+093E AA
    if (props.indic_positional_category(2369) != ipc.IPC_Bottom) { return 222; }            // U+0941 U
    if (props.indic_positional_category(2375) != ipc.IPC_Top) { return 223; }               // U+0947 E
    if (props.indic_positional_category(2507) != ipc.IPC_Left_And_Right) { return 224; }    // U+09CB
    if (props.indic_positional_category(65) != ipc.IPC_NA) { return 225; }
    if (props.indic_positional_category(1114111) != ipc.IPC_NA) { return 226; }
    if (props.general_category(65)       != props.GC_LU) { return 1; }   // 'A' U+0041
    if (props.general_category(97)       != props.GC_LL) { return 2; }   // 'a' U+0061
    if (props.general_category(48)       != props.GC_ND) { return 3; }   // '0' U+0030
    if (props.general_category(32)       != props.GC_ZS) { return 4; }   // space U+0020
    if (props.general_category(20104)    != props.GC_LO) { return 5; }   // U+4E00 (CJK range)
    if (props.general_category(769)      != props.GC_MN) { return 6; }   // U+0301 comb. acute
    if (props.general_category(128512)   != props.GC_SO) { return 7; }   // U+1F600 emoji
    if (props.general_category(1114111)  != props.GC_CN) { return 8; }   // U+10FFFF unassigned
    if (props.general_category(36)       != props.GC_SC) { return 9; }   // '$' U+0024
    if (props.general_category(40)       != props.GC_PS) { return 10; }  // '(' U+0028

    // layered predicates
    if (props.is_letter(65)  != 1) { return 11; }
    if (props.is_letter(48)  != 0) { return 12; }
    if (props.is_digit(48)   != 1) { return 13; }
    if (props.is_digit(65)   != 0) { return 14; }

    // combining class (UnicodeData field 3)
    if (props.combining_class(769) != 230) { return 15; }   // U+0301 acute = 230
    if (props.combining_class(65)  != 0)   { return 16; }   // 'A' = 0

    // script (Scripts.txt)
    if (props.script(65)    != scr.SC_Latin) { return 17; }   // 'A'
    if (props.script(913)   != scr.SC_Greek) { return 18; }   // U+0391 Alpha
    if (props.script(20104) != scr.SC_Han)   { return 19; }   // U+4E00

    // East Asian Width (EastAsianWidth.txt)
    if (props.east_asian_width(20104) != eaw.EAW_W)  { return 20; }   // CJK wide
    if (props.east_asian_width(65)    != eaw.EAW_Na) { return 21; }   // 'A' narrow

    // Bidi class (DerivedBidiClass.txt)
    if (props.bidi_class(1488) != bidi.BIDI_R) { return 22; }   // U+05D0 Hebrew alef
    if (props.bidi_class(65)   != bidi.BIDI_L) { return 23; }   // 'A'

    // Grapheme break (GraphemeBreakProperty.txt)
    if (props.grapheme_break(769) != gcb.GCB_Extend) { return 24; }   // U+0301

    // Bidi @missing default: U+0590 is UNASSIGNED but in the Hebrew block,
    // so DerivedBidiClass's "@missing: 0590..05FF; Right_To_Left" makes it R.
    if (props.bidi_class(1424) != bidi.BIDI_R) { return 25; }         // U+0590 reserved

    return 0;
}

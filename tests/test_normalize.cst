// =======================================================
// tests/test_normalize.cst — spot checks for NFD/NFC/NFKD/NFKC:
// basic decomposition/recomposition, canonical ordering (the classic
// U+1E0B U+0323 case), Hangul, and a compatibility ligature.
// The exhaustive check is tests/conformance/conf_normalize.cst.
// =======================================================

use "../src/normalize/normalize.cst" as nz;
use "../src/core/buf.cst"            as buf;

fn check(o as *buf.CpBuf, e as *i32, en as i64) as i32 {
    if (o.len != en) { return 0; }
    let is i64 as i with mut = 0;
    while (i < en) {
        if (o.ptr[i] != e[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn main() as i32 {
    let is buf.CpBuf as o = buf.cpbuf_new(16);

    // NFD: é (U+00E9) -> e + combining acute
    let is [1]i32 as in1; in1[0] = 233;
    let is [2]i32 as e1;  e1[0] = 101; e1[1] = 769;
    buf.cpbuf_reset(&o); nz.nfd(cast(*i32, &in1), 1, &o);
    if (check(&o, cast(*i32, &e1), 2) == 0) { return 1; }

    // NFC: e + combining acute -> é
    let is [2]i32 as in2; in2[0] = 101; in2[1] = 769;
    let is [1]i32 as e2;  e2[0] = 233;
    buf.cpbuf_reset(&o); nz.nfc(cast(*i32, &in2), 2, &o);
    if (check(&o, cast(*i32, &e2), 1) == 0) { return 2; }

    // Canonical ordering: U+1E0B (ḋ) U+0323 -> NFD [d, dot-below(220), dot-above(230)]
    let is [2]i32 as in3; in3[0] = 7691; in3[1] = 803;
    let is [3]i32 as e3;  e3[0] = 100; e3[1] = 803; e3[2] = 775;
    buf.cpbuf_reset(&o); nz.nfd(cast(*i32, &in3), 2, &o);
    if (check(&o, cast(*i32, &e3), 3) == 0) { return 3; }
    // NFC of the same -> [U+1E0D (ḍ), U+0307]
    let is [2]i32 as e3c; e3c[0] = 7693; e3c[1] = 775;
    buf.cpbuf_reset(&o); nz.nfc(cast(*i32, &in3), 2, &o);
    if (check(&o, cast(*i32, &e3c), 2) == 0) { return 4; }

    // Hangul: 가 (U+AC00) -> L V ; NFC back
    let is [1]i32 as in4; in4[0] = 44032;
    let is [2]i32 as e4;  e4[0] = 4352; e4[1] = 4449;
    buf.cpbuf_reset(&o); nz.nfd(cast(*i32, &in4), 1, &o);
    if (check(&o, cast(*i32, &e4), 2) == 0) { return 5; }
    buf.cpbuf_reset(&o); nz.nfc(cast(*i32, &e4), 2, &o);
    if (check(&o, cast(*i32, &in4), 1) == 0) { return 6; }

    // Hangul with trailing jamo: 각 (U+AC01) -> L V T ; NFC back
    let is [1]i32 as in5; in5[0] = 44033;
    let is [3]i32 as e5;  e5[0] = 4352; e5[1] = 4449; e5[2] = 4520;
    buf.cpbuf_reset(&o); nz.nfd(cast(*i32, &in5), 1, &o);
    if (check(&o, cast(*i32, &e5), 3) == 0) { return 7; }
    buf.cpbuf_reset(&o); nz.nfc(cast(*i32, &e5), 3, &o);
    if (check(&o, cast(*i32, &in5), 1) == 0) { return 8; }

    // Compatibility: ﬁ (U+FB01) -> NFKD "fi"; NFC leaves it unchanged
    let is [1]i32 as in6; in6[0] = 64257;
    let is [2]i32 as e6;  e6[0] = 102; e6[1] = 105;
    buf.cpbuf_reset(&o); nz.nfkd(cast(*i32, &in6), 1, &o);
    if (check(&o, cast(*i32, &e6), 2) == 0) { return 9; }
    buf.cpbuf_reset(&o); nz.nfc(cast(*i32, &in6), 1, &o);
    if (check(&o, cast(*i32, &in6), 1) == 0) { return 10; }

    // quick predicates
    if (nz.is_nfc(cast(*i32, &e2), 1)  != 1) { return 11; }   // é is NFC
    if (nz.is_nfc(cast(*i32, &in2), 2) != 0) { return 12; }   // e+acute is not NFC
    if (nz.is_nfd(cast(*i32, &in2), 2) != 1) { return 13; }   // e+acute is NFD

    buf.cpbuf_free(&o);
    return 0;
}

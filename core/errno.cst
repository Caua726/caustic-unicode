// =======================================================
// caustic-unicode/core/errno.cst
// Library error codes. Operations return a count/index >= 0 on
// success, or 0 - UERR_* (a negative value) on failure — the same
// negative-return convention as caustic-net / std/net.cst.
// UERR_END is a non-error sentinel used by iterators (segment, etc).
// =======================================================

let is i64 as UERR_INVALID    with imut = 1;   // malformed input (bad UTF, bad label)
let is i64 as UERR_NOSPACE    with imut = 2;   // caller dst buffer too small
let is i64 as UERR_TRUNC      with imut = 3;   // input ended mid-sequence
let is i64 as UERR_RANGE      with imut = 4;   // code point > 0x10FFFF / surrogate
let is i64 as UERR_OVERLONG   with imut = 5;   // overlong UTF-8 encoding
let is i64 as UERR_UNMAPPED   with imut = 6;   // no mapping in target encoding
let is i64 as UERR_DISALLOWED with imut = 7;   // IDNA disallowed code point
let is i64 as UERR_BIDI       with imut = 8;   // IDNA bidi rule violation
let is i64 as UERR_PUNYCODE   with imut = 9;   // punycode decode failure
let is i64 as UERR_END        with imut = 10;  // iterator exhausted (sentinel, not a fault)

// True when a return value signals an error (negative). UERR_END counts as
// an error here only if returned negated; iterators return 0 - UERR_END.
fn is_err(ret as i64) as i64 {
    if (ret < 0) { return 1; }
    return 0;
}

// Human-readable name for a negative 0 - UERR_* return (best effort).
fn err_name(ret as i64) as *u8 {
    let is i64 as e with mut = ret;
    if (e < 0) { e = 0 - e; }
    if (e == UERR_INVALID)    { return "UERR_INVALID"; }
    if (e == UERR_NOSPACE)    { return "UERR_NOSPACE"; }
    if (e == UERR_TRUNC)      { return "UERR_TRUNC"; }
    if (e == UERR_RANGE)      { return "UERR_RANGE"; }
    if (e == UERR_OVERLONG)   { return "UERR_OVERLONG"; }
    if (e == UERR_UNMAPPED)   { return "UERR_UNMAPPED"; }
    if (e == UERR_DISALLOWED) { return "UERR_DISALLOWED"; }
    if (e == UERR_BIDI)       { return "UERR_BIDI"; }
    if (e == UERR_PUNYCODE)   { return "UERR_PUNYCODE"; }
    if (e == UERR_END)        { return "UERR_END"; }
    return "UERR_UNKNOWN";
}

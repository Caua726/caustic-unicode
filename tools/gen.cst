// =======================================================
// caustic-unicode/tools/gen.cst
// Offline table generator (pure Caustic). Parses the UCD text files
// in tools/ucd/ and emits two-level code-point tries as .cst source
// into ucd/tables/. Run from the repo root:
//   bash tools/fetch.sh
//   caustic tools/gen.cst -o build/gen && ./build/gen
//
// PHASE 1 canary: emits ucd/tables/gc.cst (General_Category) to prove
// the whole UnicodeData -> trie -> \xNN blob -> runtime pipeline.
// =======================================================

use "std/io.cst"     as io;
use "std/string.cst" as string;
use "std/mem.cst"    as mem;
use "std/map.cst"    as map;

let is i32 as NUMCP   with imut = 1114112;   // 0x110000 code points
let is i32 as NBLOCKS with imut = 34816;     // NUMCP / 32
let is i32 as U_MAXCP with imut = 1114111;   // 0x10FFFF

// ---- low-level text parsing -------------------------------------

// Index of the next '\n' at/after pos, or len if none.
fn line_end(p as *u8, len as i32, pos as i32) as i32 {
    let is i32 as i with mut = pos;
    while (i < len) {
        if (p[i] == 10) { return i; }
        i = i + 1;
    }
    return len;
}

// Start offset of ';'-separated field `idx` in line[0..llen); writes the
// field end (exclusive) to *endout. Returns -1 if the field is absent.
fn field(p as *u8, llen as i32, idx as i32, endout as *i32) as i32 {
    let is i32 as cur with mut = 0;
    let is i32 as i with mut = 0;
    let is i32 as fstart with mut = 0;
    while (cur < idx) {
        while (i < llen && p[i] != 59) { i = i + 1; }   // 59 = ';'
        if (i >= llen) { return cast(i32, 0 - 1); }
        i = i + 1;
        cur = cur + 1;
        fstart = i;
    }
    let is i32 as e with mut = fstart;
    while (e < llen && p[e] != 59) { e = e + 1; }
    endout[0] = e;
    return fstart;
}

fn hexval(c as u8) as i32 {
    if (c >= 48 && c <= 57)  { return cast(i32, c) - 48; }
    if (c >= 65 && c <= 70)  { return cast(i32, c) - 55; }
    if (c >= 97 && c <= 102) { return cast(i32, c) - 87; }
    return cast(i32, 0 - 1);
}

// Parse hex digits in p[start..end). Returns -1 on a bad digit.
fn parse_hex(p as *u8, start as i32, end as i32) as i32 {
    let is i32 as v with mut = 0;
    let is i32 as i with mut = start;
    if (start >= end) { return cast(i32, 0 - 1); }
    while (i < end) {
        let is i32 as d = hexval(p[i]);
        if (d < 0) { return cast(i32, 0 - 1); }
        v = (v << 4) | d;
        i = i + 1;
    }
    return v;
}

// 1 if p[start..end) ends with the cstr `suf` (suflen bytes), else 0.
fn ends_with(p as *u8, start as i32, end as i32, suf as *u8, suflen as i32) as i32 {
    if (end - start < suflen) { return 0; }
    let is i32 as i with mut = 0;
    while (i < suflen) {
        if (p[end - suflen + i] != suf[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

// General_Category 2-letter code -> numeric id. MUST match ucd/props.cst.
// Cn = 0 (default / unassigned). Returns 0 for anything unrecognized.
fn gc_id(p as *u8, start as i32, end as i32) as i32 {
    if (end - start < 2) { return 0; }
    let is u8 as a = p[start];
    let is u8 as b = p[start + 1];
    if (a == 76) {                                   // 'L'
        if (b == 117) { return 1; }                  // Lu
        if (b == 108) { return 2; }                  // Ll
        if (b == 116) { return 3; }                  // Lt
        if (b == 109) { return 4; }                  // Lm
        if (b == 111) { return 5; }                  // Lo
    }
    if (a == 77) {                                   // 'M'
        if (b == 110) { return 6; }                  // Mn
        if (b == 99)  { return 7; }                  // Mc
        if (b == 101) { return 8; }                  // Me
    }
    if (a == 78) {                                   // 'N'
        if (b == 100) { return 9; }                  // Nd
        if (b == 108) { return 10; }                 // Nl
        if (b == 111) { return 11; }                 // No
    }
    if (a == 80) {                                   // 'P'
        if (b == 99)  { return 12; }                 // Pc
        if (b == 100) { return 13; }                 // Pd
        if (b == 115) { return 14; }                 // Ps
        if (b == 101) { return 15; }                 // Pe
        if (b == 105) { return 16; }                 // Pi
        if (b == 102) { return 17; }                 // Pf
        if (b == 111) { return 18; }                 // Po
    }
    if (a == 83) {                                   // 'S'
        if (b == 109) { return 19; }                 // Sm
        if (b == 99)  { return 20; }                 // Sc
        if (b == 107) { return 21; }                 // Sk
        if (b == 111) { return 22; }                 // So
    }
    if (a == 90) {                                   // 'Z'
        if (b == 115) { return 23; }                 // Zs
        if (b == 108) { return 24; }                 // Zl
        if (b == 112) { return 25; }                 // Zp
    }
    if (a == 67) {                                   // 'C'
        if (b == 99)  { return 26; }                 // Cc
        if (b == 102) { return 27; }                 // Cf
        if (b == 115) { return 28; }                 // Cs
        if (b == 111) { return 29; }                 // Co
    }
    return 0;                                         // Cn
}

// Read a whole file into a fresh mmap'd buffer (NUL-terminated). The io
// heap's bins caps at 64 KB, so io.read_file can't slurp multi-MB UCD
// files — we mmap our own. Writes byte length to *out_len. Null on error.
fn slurp(path as *u8, out_len as *i32) as *u8 {
    let is i64 as fd = io._open_read(path);
    if (fd < 0) { return cast(*u8, 0); }
    let is i64 as size = io._lseek(fd, 0, io._SEEK_END);
    io._lseek(fd, 0, io._SEEK_SET);
    if (size <= 0) { io._close_fd(fd); return cast(*u8, 0); }
    let is *u8 as buf = mem.core.mmap_anon(size + 1);
    if (cast(i64, buf) == 0) { io._close_fd(fd); return cast(*u8, 0); }
    io.read_exact(fd, buf, size);
    io._close_fd(fd);
    out_len[0] = cast(i32, size);
    return buf;
}

// ---- trie build ----

fn block_hash(arr as *u16, base as i32) as i64 {
    let is i64 as h with mut = 1469598103934665603;  // FNV-1a offset basis
    let is i32 as j with mut = 0;
    while (j < 32) {
        h = h ^ cast(i64, arr[base + j]);
        h = h * 1099511628211;                       // FNV-1a prime
        j = j + 1;
    }
    return h;
}

fn block_eq(flat as *u16, fbase as i32, data as *u16, dbase as i32) as i32 {
    let is i32 as j with mut = 0;
    while (j < 32) {
        if (flat[fbase + j] != data[dbase + j]) { return 0; }
        j = j + 1;
    }
    return 1;
}

// ---- .cst emission ----

fn ws(w as *io.Writer, s as *u8) as void { io.write(w, string.String(s)); }
fn wi(w as *io.Writer, n as i32) as void { io.write_i64(w, cast(i64, n)); }
fn wn(w as *io.Writer, name as *u8, suf as *u8) as void {
    io.write(w, string.String(name));
    io.write(w, string.String(suf));
}

fn hex_digit(v as i32) as u8 {
    if (v < 10) { return cast(u8, 48 + v); }
    return cast(u8, 87 + v);                          // 'a'..'f'
}

// Emit one byte as a \xNN hex escape into a string literal. The bytes land
// in .rodata via the string-init global (codegen NUL emission was fixed in
// the Caustic compiler, so raw bytes round-trip cleanly).
fn emit_byte_hex(w as *io.Writer, b as u8) as void {
    io.put(w, 92);                                    // '\'
    io.put(w, 120);                                   // 'x'
    io.put(w, hex_digit((cast(i32, b) >> 4) & 15));
    io.put(w, hex_digit(cast(i32, b) & 15));
}

// Emit a u16 array as chunked string-init globals: <name><kind>_<k>.
// Returns the number of chunks emitted.
fn emit_u16_blob(w as *io.Writer, name as *u8, kind as *u8, data as *u16, count as i32) as i32 {
    let is i32 as total = count << 1;                 // bytes
    let is i32 as nchunks = (total + 4095) / 4096;
    let is i32 as k with mut = 0;
    while (k < nchunks) {
        ws(w, "let is *u8 as "); wn(w, name, kind); io.put(w, 95); wi(w, k);
        ws(w, " with imut = \"");
        let is i32 as start = k * 4096;
        let is i32 as end with mut = start + 4096;
        if (end > total) { end = total; }
        let is i32 as bp with mut = start;
        while (bp < end) {
            let is i32 as v = cast(i32, data[bp >> 1]);
            let is u8 as byte with mut = cast(u8, v & 255);
            if ((bp & 1) == 1) { byte = cast(u8, (v >> 8) & 255); }
            emit_byte_hex(w, byte);
            bp = bp + 1;
        }
        ws(w, "\";\n");
        k = k + 1;
    }
    return nchunks;
}

// Emit a u32 array as chunked \xNN string-init globals (little-endian).
// Returns the number of chunks emitted.
fn emit_u32_blob(w as *io.Writer, name as *u8, kind as *u8, data as *u32, count as i32) as i32 {
    let is i32 as total = count << 2;                 // bytes
    let is i32 as nchunks = (total + 4095) / 4096;
    let is i32 as k with mut = 0;
    while (k < nchunks) {
        ws(w, "let is *u8 as "); wn(w, name, kind); io.put(w, 95); wi(w, k);
        ws(w, " with imut = \"");
        let is i32 as start = k * 4096;
        let is i32 as end with mut = start + 4096;
        if (end > total) { end = total; }
        let is i32 as bp with mut = start;
        while (bp < end) {
            let is i32 as v = cast(i32, data[bp >> 2]);
            let is i32 as sh = (bp & 3) << 3;          // 0, 8, 16, 24
            emit_byte_hex(w, cast(u8, (v >> sh) & 255));
            bp = bp + 1;
        }
        ws(w, "\";\n");
        k = k + 1;
    }
    return nchunks;
}

// Emit a flat u32 array as chunked globals + a <name>_at(i) reader.
fn emit_flat_u32(w as *io.Writer, name as *u8, data as *u32, count as i32) as void {
    let is i32 as nc = emit_u32_blob(w, name, "", data, count);
    ws(w, "\nlet is ["); wi(w, nc); ws(w, "]*u8 as "); wn(w, name, "_chunks with mut;\n");
    ws(w, "let is i32 as "); wn(w, name, "_ready with mut = 0;\n");
    ws(w, "fn "); wn(w, name, "_init() as void {\n  if ("); wn(w, name, "_ready == 1) { return; }\n");
    let is i32 as i with mut = 0;
    while (i < nc) {
        ws(w, "  "); wn(w, name, "_chunks["); wi(w, i); ws(w, "] = "); wn(w, name, "_"); wi(w, i); ws(w, ";\n");
        i = i + 1;
    }
    ws(w, "  "); wn(w, name, "_ready = 1;\n}\n");
    ws(w, "fn "); wn(w, name, "_at(i as i32) as i32 {\n  if ("); wn(w, name, "_ready == 0) { "); wn(w, name, "_init(); }\n");
    ws(w, "  return trie.blob_u32(cast(**u8, &"); wn(w, name, "_chunks), i);\n}\n");
}

// Emit the chunk-pointer arrays, init(), constants and the <name>_get()
// accessor that drives ucd/trie.cst:lookup2.
fn emit_tail(w as *io.Writer, name as *u8, nidx as i32, ndat as i32, maxcp as i32, def as i32) as void {
    ws(w, "\nlet is ["); wi(w, nidx); ws(w, "]*u8 as "); wn(w, name, "_index_chunks with mut;\n");
    ws(w, "let is [");   wi(w, ndat); ws(w, "]*u8 as "); wn(w, name, "_data_chunks with mut;\n");
    ws(w, "let is i32 as "); wn(w, name, "_ready with mut = 0;\n\n");

    ws(w, "fn "); wn(w, name, "_init() as void {\n");
    ws(w, "  if ("); wn(w, name, "_ready == 1) { return; }\n");
    let is i32 as i with mut = 0;
    while (i < nidx) {
        ws(w, "  "); wn(w, name, "_index_chunks["); wi(w, i); ws(w, "] = ");
        wn(w, name, "_index_"); wi(w, i); ws(w, ";\n");
        i = i + 1;
    }
    i = 0;
    while (i < ndat) {
        ws(w, "  "); wn(w, name, "_data_chunks["); wi(w, i); ws(w, "] = ");
        wn(w, name, "_data_"); wi(w, i); ws(w, ";\n");
        i = i + 1;
    }
    ws(w, "  "); wn(w, name, "_ready = 1;\n}\n\n");

    ws(w, "let is i32 as "); wn(w, name, "_maxcp with imut = "); wi(w, maxcp); ws(w, ";\n");
    ws(w, "let is i32 as "); wn(w, name, "_default with imut = "); wi(w, def); ws(w, ";\n\n");

    ws(w, "fn "); wn(w, name, "_get(cp as i32) as i32 {\n");
    ws(w, "  if ("); wn(w, name, "_ready == 0) { "); wn(w, name, "_init(); }\n");
    ws(w, "  return trie.lookup2(cast(**u8, &"); wn(w, name, "_index_chunks), cast(**u8, &");
    wn(w, name, "_data_chunks), cp, "); wn(w, name, "_maxcp, "); wn(w, name, "_default);\n}\n");
}

// Compress flat[NUMCP] into a 2-level trie: fills index[NBLOCKS] with block
// ids and data[] with the deduplicated 32-cp blocks. Block id 0 is the
// all-default block. Returns the data length (in u16 elements).
fn build_trie(flat as *u16, def as i32, index as *u16, data as *u16) as i32 {
    let is i32 as data_count with mut = 0;
    let is map.MapI64 as dmap = map.mapi64_new();

    // Seed data block 0 = the all-default block (shared by every gap).
    let is i32 as j0 with mut = 0;
    while (j0 < 32) { data[j0] = cast(u16, def); j0 = j0 + 1; }
    data_count = 32;
    map.mapi64_set(&dmap, block_hash(data, 0), 0);

    let is i32 as b with mut = 0;
    while (b < NBLOCKS) {
        let is i32 as base = b << 5;
        let is i64 as hsh = block_hash(flat, base);
        let is i64 as found = map.mapi64_get(&dmap, hsh, 0 - 1);
        let is i32 as id with mut = cast(i32, 0 - 1);
        if (found >= 0) {
            if (block_eq(flat, base, data, cast(i32, found) << 5) == 1) { id = cast(i32, found); }
        }
        if (id < 0) {
            id = data_count >> 5;
            let is i32 as j with mut = 0;
            while (j < 32) { data[data_count + j] = flat[base + j]; j = j + 1; }
            data_count = data_count + 32;
            map.mapi64_set(&dmap, hsh, cast(i64, id));
        }
        index[b] = cast(u16, id);
        b = b + 1;
    }
    return data_count;
}

// Build the trie from a filled flat[NUMCP] array and write <path>.
// `name` is the table prefix used for every generated symbol.
fn build_and_emit(path as *u8, name as *u8, prefix as *u8, flat as *u16, def as i32, maxcp as i32, names as *i64, ncount as i32) as i32 {
    let is *u16 as index = cast(*u16, mem.core.mmap_anon(cast(i64, NBLOCKS) * 2));
    let is *u16 as data  = cast(*u16, mem.core.mmap_anon(cast(i64, NUMCP) * 2));
    if (cast(i64, index) == 0 || cast(i64, data) == 0) { return cast(i32, 0 - 1); }
    let is i32 as data_count = build_trie(flat, def, index, data);

    let is i64 as fd = io._open_write(path);
    if (fd < 0) { return cast(i32, 0 - 1); }
    let is [16384]u8 as wbuf;
    let is io.Writer as w = io.Writer(fd, cast(*u8, &wbuf), 16384);
    ws(&w, "// GENERATED by tools/gen.cst from the UCD (Unicode 16.0). DO NOT EDIT.\n");
    ws(&w, "// Regenerate: bash tools/fetch.sh && caustic tools/gen.cst -o build/gen && ./build/gen\n");
    ws(&w, "use \"../trie.cst\" as trie;\n\n");
    let is i32 as nidx = emit_u16_blob(&w, name, "_index", index, NBLOCKS);
    let is i32 as ndat = emit_u16_blob(&w, name, "_data", data, data_count);
    emit_tail(&w, name, nidx, ndat, maxcp, def);
    // Named value constants (<PREFIX>_<Name> = id) for interned enum tables.
    let is i32 as ci with mut = 0;
    while (ci < ncount) {
        ws(&w, "let is i64 as "); ws(&w, prefix); io.put(&w, 95);
        ws(&w, cast(*u8, names[ci])); ws(&w, " with imut = "); wi(&w, ci); ws(&w, ";\n");
        ci = ci + 1;
    }
    io.flush(&w);
    io._close_fd(fd);

    io.write_str(1, "  blocks="); io.write_int(1, cast(i64, data_count >> 5));
    io.write_str(1, " idx_chunks="); io.write_int(1, cast(i64, nidx));
    io.write_str(1, " data_chunks="); io.write_int(1, cast(i64, ndat));
    io.write_str(1, "\n");
    return 0;
}

// ---- General_Category (UnicodeData.txt field 2, + First/Last ranges) ----

fn gen_gc() as i32 {
    let is i32 as len with mut = 0;
    let is *u8 as p = slurp("tools/ucd/UnicodeData.txt", &len);
    if (cast(i64, p) == 0) {
        io.write_str(1, "gen_gc: cannot read tools/ucd/UnicodeData.txt\n");
        return cast(i32, 0 - 1);
    }

    let is *u16 as flat = cast(*u16, mem.core.mmap_anon(cast(i64, NUMCP) * 2));
    if (cast(i64, flat) == 0) { return cast(i32, 0 - 1); }   // zero-filled => GC_Cn default

    let is i32 as pending with mut = cast(i32, 0 - 1);
    let is i32 as pending_gc with mut = 0;
    let is i32 as pos with mut = 0;
    while (pos < len) {
        let is i32 as le = line_end(p, len, pos);
        let is i32 as llen = le - pos;
        if (llen > 0) {
            let is *u8 as lp = cast(*u8, cast(i64, p) + pos);
            let is i32 as f0e with mut = 0;
            let is i32 as f0s = field(lp, llen, 0, &f0e);
            let is i32 as f1e with mut = 0;
            let is i32 as f1s = field(lp, llen, 1, &f1e);
            let is i32 as f2e with mut = 0;
            let is i32 as f2s = field(lp, llen, 2, &f2e);
            if (f0s >= 0 && f1s >= 0 && f2s >= 0) {
                let is i32 as cp = parse_hex(lp, f0s, f0e);
                let is i32 as g  = gc_id(lp, f2s, f2e);
                if (ends_with(lp, f1s, f1e, "First>", 6) == 1) {
                    pending = cp; pending_gc = g;
                } else if (ends_with(lp, f1s, f1e, "Last>", 5) == 1) {
                    if (pending >= 0) {
                        let is i32 as c with mut = pending;
                        while (c <= cp) { flat[c] = cast(u16, pending_gc); c = c + 1; }
                        pending = cast(i32, 0 - 1);
                    }
                } else {
                    if (cp >= 0 && cp < NUMCP) { flat[cp] = cast(u16, g); }
                }
            }
        }
        pos = le + 1;
    }

    io.write_str(1, "gc:");
    return build_and_emit("ucd/tables/gc.cst", "gc", "GC", flat, 0, U_MAXCP, cast(*i64, 0), 0);
}

// ---- generic enum-property files ("RANGE ; Value # comment") ----

fn cstrlen(s as *u8) as i32 {
    let is i32 as i with mut = 0;
    while (s[i] != 0) { i = i + 1; }
    return i;
}

fn find_char(p as *u8, start as i32, end as i32, ch as i32) as i32 {
    let is i32 as i with mut = start;
    while (i < end) {
        if (cast(i32, p[i]) == ch) { return i; }
        i = i + 1;
    }
    return cast(i32, 0 - 1);
}

// 1 if p[s..e) equals the NUL-terminated cstr t exactly.
fn slice_eq(p as *u8, s as i32, e as i32, t as *u8) as i32 {
    let is i32 as n = e - s;
    let is i32 as i with mut = 0;
    while (i < n) {
        if (t[i] == 0) { return 0; }
        if (p[s + i] != t[i]) { return 0; }
        i = i + 1;
    }
    if (t[n] != 0) { return 0; }
    return 1;
}

// Index of cstr t inside p[start..end), or -1.
fn find_substr(p as *u8, start as i32, end as i32, t as *u8) as i32 {
    let is i32 as tn with mut = 0;
    while (t[tn] != 0) { tn = tn + 1; }
    if (tn == 0) { return start; }
    let is i32 as i with mut = start;
    while (i + tn <= end) {
        let is i32 as j with mut = 0;
        while (j < tn && p[i + j] == t[j]) { j = j + 1; }
        if (j == tn) { return i; }
        i = i + 1;
    }
    return cast(i32, 0 - 1);
}

fn parse_dec(p as *u8, start as i32, end as i32) as i32 {
    let is i32 as v with mut = 0;
    let is i32 as i with mut = start;
    while (i < end) {
        if (p[i] < 48 || p[i] > 57) { return v; }
        v = v * 10 + (cast(i32, p[i]) - 48);
        i = i + 1;
    }
    return v;
}

// Parse "HHHH" or "HHHH..HHHH" in p[start..end) (spaces trimmed) -> *lo,*hi.
fn parse_range(p as *u8, start as i32, end as i32, lo as *i32, hi as *i32) as void {
    let is i32 as s with mut = start;
    let is i32 as e with mut = end;
    while (s < e && (p[s] == 32 || p[s] == 9)) { s = s + 1; }
    while (e > s && (p[e - 1] == 32 || p[e - 1] == 9)) { e = e - 1; }
    let is i32 as dot with mut = cast(i32, 0 - 1);
    let is i32 as i with mut = s;
    while (i < e - 1) {
        if (p[i] == 46 && p[i + 1] == 46) { dot = i; i = e; }   // 46 = '.'
        else { i = i + 1; }
    }
    if (dot < 0) {
        let is i32 as cp = parse_hex(p, s, e);
        lo[0] = cp; hi[0] = cp;
    } else {
        lo[0] = parse_hex(p, s, dot);
        hi[0] = parse_hex(p, dot + 2, e);
    }
}

// Value-name interner: assigns ids in first-seen order (default = 0).
// Keys point into a stable mmap'd arena (MapStr stores the pointer).
struct Interner {
    map   as *map.MapStr;
    arena as *u8;
    aoff  as i32;
    names as *i64;      // id -> arena cstr pointer (for constant emission)
    count as i32;
}

fn intern(it as *Interner, p as *u8, start as i32, end as i32) as i32 {
    let is i32 as n = end - start;
    let is *u8 as dst = cast(*u8, cast(i64, it.arena) + cast(i64, it.aoff));
    let is i32 as j with mut = 0;
    while (j < n) { dst[j] = p[start + j]; j = j + 1; }
    dst[n] = cast(u8, 0);
    let is i64 as found = map.mapstr_get(it.map, dst, cast(i64, 0 - 1));
    if (found >= 0) { return cast(i32, found); }   // dst stays scratch, reused
    let is i32 as id = it.count;
    it.names[id] = cast(i64, dst);
    map.mapstr_set(it.map, dst, cast(i64, id));
    it.aoff = it.aoff + n + 1;                      // commit the bytes
    it.count = it.count + 1;
    return id;
}

fn gen_enum_file(in_path as *u8, out_path as *u8, name as *u8, prefix as *u8,
                 default_name as *u8, maxcp as i32) as i32 {
    let is i32 as len with mut = 0;
    let is *u8 as p = slurp(in_path, &len);
    if (cast(i64, p) == 0) {
        io.write_str(1, "gen: cannot read "); io.write_str(1, in_path); io.write_str(1, "\n");
        return cast(i32, 0 - 1);
    }
    let is *u16 as flat = cast(*u16, mem.core.mmap_anon(cast(i64, NUMCP) * 2));
    if (cast(i64, flat) == 0) { return cast(i32, 0 - 1); }

    let is map.MapStr as nm = map.mapstr_new();
    let is [512]i64 as names_arr with mut;
    let is Interner as it;
    it.map = &nm;
    it.arena = mem.core.mmap_anon(65536);
    it.aoff = 0;
    it.names = cast(*i64, &names_arr);
    it.count = 0;
    intern(&it, default_name, 0, cstrlen(default_name));   // default => id 0

    let is i32 as pos with mut = 0;
    while (pos < len) {
        let is i32 as le = line_end(p, len, pos);
        let is i32 as llen = le - pos;
        if (llen > 0) {
            let is *u8 as lp = cast(*u8, cast(i64, p) + pos);
            if (lp[0] != 35) {                                 // 35 = '#'
                let is i32 as semi = find_char(lp, 0, llen, 59);   // ';'
                if (semi >= 0) {
                    let is i32 as lo with mut = 0;
                    let is i32 as hi with mut = 0;
                    parse_range(lp, 0, semi, &lo, &hi);
                    let is i32 as vs with mut = semi + 1;
                    let is i32 as ve with mut = llen;
                    let is i32 as hh = find_char(lp, vs, llen, 35);
                    if (hh >= 0) { ve = hh; }
                    while (vs < ve && (lp[vs] == 32 || lp[vs] == 9)) { vs = vs + 1; }
                    while (ve > vs && (lp[ve - 1] == 32 || lp[ve - 1] == 9 || lp[ve - 1] == 13)) { ve = ve - 1; }
                    if (ve > vs && lo >= 0 && hi >= lo && hi < NUMCP) {
                        let is i32 as id = intern(&it, lp, vs, ve);
                        let is i32 as c with mut = lo;
                        while (c <= hi) { flat[c] = cast(u16, id); c = c + 1; }
                    }
                }
            }
        }
        pos = le + 1;
    }

    io.write_str(1, name); io.write_str(1, ":");
    return build_and_emit(out_path, name, prefix, flat, 0, maxcp, it.names, it.count);
}

// ---- Canonical_Combining_Class (UnicodeData.txt field 3, decimal) ----

fn gen_ccc() as i32 {
    let is i32 as len with mut = 0;
    let is *u8 as p = slurp("tools/ucd/UnicodeData.txt", &len);
    if (cast(i64, p) == 0) { return cast(i32, 0 - 1); }
    let is *u16 as flat = cast(*u16, mem.core.mmap_anon(cast(i64, NUMCP) * 2));
    if (cast(i64, flat) == 0) { return cast(i32, 0 - 1); }
    let is i32 as pending with mut = cast(i32, 0 - 1);
    let is i32 as pending_cc with mut = 0;
    let is i32 as pos with mut = 0;
    while (pos < len) {
        let is i32 as le = line_end(p, len, pos);
        let is i32 as llen = le - pos;
        if (llen > 0) {
            let is *u8 as lp = cast(*u8, cast(i64, p) + pos);
            let is i32 as f0e with mut = 0;
            let is i32 as f0s = field(lp, llen, 0, &f0e);
            let is i32 as f1e with mut = 0;
            let is i32 as f1s = field(lp, llen, 1, &f1e);
            let is i32 as f3e with mut = 0;
            let is i32 as f3s = field(lp, llen, 3, &f3e);
            if (f0s >= 0 && f1s >= 0 && f3s >= 0) {
                let is i32 as cp = parse_hex(lp, f0s, f0e);
                let is i32 as cc = parse_dec(lp, f3s, f3e);
                if (ends_with(lp, f1s, f1e, "First>", 6) == 1) {
                    pending = cp; pending_cc = cc;
                } else if (ends_with(lp, f1s, f1e, "Last>", 5) == 1) {
                    if (pending >= 0) {
                        let is i32 as c with mut = pending;
                        while (c <= cp) { flat[c] = cast(u16, pending_cc); c = c + 1; }
                        pending = cast(i32, 0 - 1);
                    }
                } else {
                    if (cp >= 0 && cp < NUMCP) { flat[cp] = cast(u16, cc); }
                }
            }
        }
        pos = le + 1;
    }
    io.write_str(1, "ccc:");
    return build_and_emit("ucd/tables/ccc.cst", "ccc", "CCC", flat, 0, U_MAXCP, cast(*i64, 0), 0);
}

// ---- Bidi_Class (DerivedBidiClass.txt) ----
// Unlike the other property files, this one gives the default class of
// UNASSIGNED code points through "# @missing: RANGE; LongName" lines, and
// the explicit body uses short names (L, R, AL, ...). We must apply the
// @missing defaults AND map the long names to the short ones, or every
// reserved code point in an RTL block would wrongly resolve to L.

// Map a Bidi_Class value name to its canonical short form (writes to out,
// returns length). The four long forms below are the ones used by @missing
// in Unicode 16.0; everything else (the short body names) is copied as-is.
fn bidi_canon(p as *u8, s as i32, e as i32, out as *u8) as i32 {
    if (slice_eq(p, s, e, "Left_To_Right") == 1)       { out[0] = 76; return 1; }               // L
    if (slice_eq(p, s, e, "Right_To_Left") == 1)       { out[0] = 82; return 1; }               // R
    if (slice_eq(p, s, e, "Arabic_Letter") == 1)       { out[0] = 65; out[1] = 76; return 2; }  // AL
    if (slice_eq(p, s, e, "European_Terminator") == 1) { out[0] = 69; out[1] = 84; return 2; }  // ET
    let is i32 as n = e - s;
    let is i32 as i with mut = 0;
    while (i < n) { out[i] = p[s + i]; i = i + 1; }
    return n;
}

fn gen_bidi() as i32 {
    let is i32 as len with mut = 0;
    let is *u8 as p = slurp("tools/ucd/DerivedBidiClass.txt", &len);
    if (cast(i64, p) == 0) {
        io.write_str(1, "gen: cannot read tools/ucd/DerivedBidiClass.txt\n");
        return cast(i32, 0 - 1);
    }
    let is *u16 as flat = cast(*u16, mem.core.mmap_anon(cast(i64, NUMCP) * 2));
    if (cast(i64, flat) == 0) { return cast(i32, 0 - 1); }

    let is map.MapStr as nm = map.mapstr_new();
    let is [512]i64 as names_arr with mut;
    let is Interner as it;
    it.map = &nm;
    it.arena = mem.core.mmap_anon(65536);
    it.aoff = 0;
    it.names = cast(*i64, &names_arr);
    it.count = 0;
    let is [64]u8 as cbuf;
    intern(&it, "L", 0, 1);   // default Bidi_Class = L => id 0 (zero-filled flat)

    // Single forward pass: @missing comment lines precede the explicit body
    // in the UCD file, so defaults are applied before the assignments that
    // override them.
    let is i32 as pos with mut = 0;
    while (pos < len) {
        let is i32 as le = line_end(p, len, pos);
        let is i32 as llen = le - pos;
        if (llen > 0) {
            let is *u8 as lp = cast(*u8, cast(i64, p) + pos);
            let is i32 as rs with mut = cast(i32, 0 - 1);   // where the "RANGE; value" starts
            if (lp[0] == 35) {                              // 35 = '#'
                let is i32 as mi = find_substr(lp, 0, llen, "@missing:");
                if (mi >= 0) { rs = mi + 9; }               // 9 = len("@missing:")
            } else {
                rs = 0;
            }
            if (rs >= 0) {
                let is i32 as semi = find_char(lp, rs, llen, 59);   // ';'
                if (semi >= 0) {
                    let is i32 as lo with mut = 0;
                    let is i32 as hi with mut = 0;
                    parse_range(lp, rs, semi, &lo, &hi);
                    let is i32 as vs with mut = semi + 1;
                    let is i32 as ve with mut = llen;
                    let is i32 as hh = find_char(lp, vs, llen, 35);
                    if (hh >= 0) { ve = hh; }
                    while (vs < ve && (lp[vs] == 32 || lp[vs] == 9)) { vs = vs + 1; }
                    while (ve > vs && (lp[ve - 1] == 32 || lp[ve - 1] == 9 || lp[ve - 1] == 13)) { ve = ve - 1; }
                    if (ve > vs && lo >= 0 && hi >= lo && hi < NUMCP) {
                        let is i32 as cl = bidi_canon(lp, vs, ve, cast(*u8, &cbuf));
                        let is i32 as id = intern(&it, cast(*u8, &cbuf), 0, cl);
                        let is i32 as c with mut = lo;
                        while (c <= hi) { flat[c] = cast(u16, id); c = c + 1; }
                    }
                }
            }
        }
        pos = le + 1;
    }
    io.write_str(1, "bidi:");
    return build_and_emit("ucd/tables/bidi.cst", "bidi", "BIDI", flat, 0, U_MAXCP, it.names, it.count);
}

// ---- Decomposition (UnicodeData.txt field 5) ----
// trie cp -> meta index (0 = no decomposition). meta record is a packed u32:
//   bits 0..19 = pool offset, 20..27 = length, 28 = is_compatibility.
// pool holds the decomposition code points (u32 each). Canonical and
// compatibility decompositions share the table; the flag tells them apart
// (NFD uses canonical only; NFKD uses both).
fn gen_decomp() as i32 {
    let is i32 as len with mut = 0;
    let is *u8 as p = slurp("tools/ucd/UnicodeData.txt", &len);
    if (cast(i64, p) == 0) { return cast(i32, 0 - 1); }
    let is *u16 as flat = cast(*u16, mem.core.mmap_anon(cast(i64, NUMCP) * 2));
    let is *u32 as meta = cast(*u32, mem.core.mmap_anon(cast(i64, 30000) * 4));
    let is *u32 as pool = cast(*u32, mem.core.mmap_anon(cast(i64, 100000) * 4));
    if (cast(i64, flat) == 0 || cast(i64, meta) == 0 || cast(i64, pool) == 0) { return cast(i32, 0 - 1); }
    let is i32 as meta_count with mut = 1;   // index 0 reserved = "no decomposition"
    meta[0] = cast(u32, 0);
    let is i32 as pool_count with mut = 0;

    let is i32 as pos with mut = 0;
    while (pos < len) {
        let is i32 as le = line_end(p, len, pos);
        let is i32 as llen = le - pos;
        if (llen > 0) {
            let is *u8 as lp = cast(*u8, cast(i64, p) + pos);
            let is i32 as f0e with mut = 0;
            let is i32 as f0s = field(lp, llen, 0, &f0e);
            let is i32 as f5e with mut = 0;
            let is i32 as f5s = field(lp, llen, 5, &f5e);
            if (f0s >= 0 && f5s >= 0 && f5e > f5s) {
                let is i32 as cp = parse_hex(lp, f0s, f0e);
                let is i32 as is_compat with mut = 0;
                let is i32 as q with mut = f5s;
                while (q < f5e && (lp[q] == 32 || lp[q] == 9)) { q = q + 1; }
                if (q < f5e && lp[q] == 60) {                 // '<' compatibility tag
                    is_compat = 1;
                    while (q < f5e && lp[q] != 62) { q = q + 1; }   // skip to '>'
                    if (q < f5e) { q = q + 1; }
                }
                let is i32 as off = pool_count;
                let is i32 as dn with mut = 0;
                while (q < f5e) {
                    while (q < f5e && (lp[q] == 32 || lp[q] == 9)) { q = q + 1; }
                    let is i32 as ts = q;
                    while (q < f5e && lp[q] != 32 && lp[q] != 9) { q = q + 1; }
                    if (q > ts) {
                        pool[pool_count] = cast(u32, parse_hex(lp, ts, q));
                        pool_count = pool_count + 1;
                        dn = dn + 1;
                    }
                }
                if (dn > 0 && cp >= 0 && cp < NUMCP) {
                    meta[meta_count] = cast(u32, off) | (cast(u32, dn) << 20) | (cast(u32, is_compat) << 28);
                    flat[cp] = cast(u16, meta_count);
                    meta_count = meta_count + 1;
                }
            }
        }
        pos = le + 1;
    }

    let is *u16 as index = cast(*u16, mem.core.mmap_anon(cast(i64, NBLOCKS) * 2));
    let is *u16 as data  = cast(*u16, mem.core.mmap_anon(cast(i64, NUMCP) * 2));
    let is i32 as data_count = build_trie(flat, 0, index, data);
    let is i64 as fd = io._open_write("ucd/tables/decomp.cst");
    if (fd < 0) { return cast(i32, 0 - 1); }
    let is [16384]u8 as wbuf;
    let is io.Writer as w = io.Writer(fd, cast(*u8, &wbuf), 16384);
    ws(&w, "// GENERATED by tools/gen.cst from UnicodeData.txt field 5 (Unicode 16.0). DO NOT EDIT.\n");
    ws(&w, "// trie: cp -> meta index (0 = none). meta packed u32: off(0..19) len(20..27) compat(28).\n");
    ws(&w, "use \"../trie.cst\" as trie;\n\n");
    let is i32 as nidx = emit_u16_blob(&w, "decomp", "_index", index, NBLOCKS);
    let is i32 as ndat = emit_u16_blob(&w, "decomp", "_data", data, data_count);
    emit_tail(&w, "decomp", nidx, ndat, U_MAXCP, 0);
    emit_flat_u32(&w, "decomp_meta", meta, meta_count);
    emit_flat_u32(&w, "decomp_pool", pool, pool_count);
    io.flush(&w);
    io._close_fd(fd);
    io.write_str(1, "decomp:  meta="); io.write_int(1, cast(i64, meta_count));
    io.write_str(1, " pool="); io.write_int(1, cast(i64, pool_count)); io.write_str(1, "\n");
    return 0;
}

// In-place quicksort of an i64 array over [lo, hi].
fn qsort_i64(a as *i64, lo as i32, hi as i32) as void {
    if (lo >= hi) { return; }
    let is i64 as pivot = a[(lo + hi) / 2];
    let is i32 as i with mut = lo;
    let is i32 as j with mut = hi;
    while (i <= j) {
        while (a[i] < pivot) { i = i + 1; }
        while (a[j] > pivot) { j = j - 1; }
        if (i <= j) {
            let is i64 as t = a[i]; a[i] = a[j]; a[j] = t;
            i = i + 1; j = j - 1;
        }
    }
    if (lo < j) { qsort_i64(a, lo, j); }
    if (i < hi) { qsort_i64(a, i, hi); }
}

// ---- Canonical composition (NFC) ----
// Primary composites: cps with a canonical decomposition [a,b] that are NOT
// in Full_Composition_Exclusion (DerivedNormalizationProps.txt). Emitted as
// three parallel u32 arrays (ca, cb, cc) sorted by (a,b) for binary search.
fn gen_compose() as i32 {
    // 1. Full_Composition_Exclusion set.
    let is i32 as dlen with mut = 0;
    let is *u8 as dp = slurp("tools/ucd/DerivedNormalizationProps.txt", &dlen);
    if (cast(i64, dp) == 0) { return cast(i32, 0 - 1); }
    let is *u8 as excl = mem.core.mmap_anon(cast(i64, NUMCP));
    if (cast(i64, excl) == 0) { return cast(i32, 0 - 1); }
    let is i32 as pos with mut = 0;
    while (pos < dlen) {
        let is i32 as le = line_end(dp, dlen, pos);
        let is i32 as llen = le - pos;
        if (llen > 0 && dp[pos] != 35) {
            let is *u8 as lp = cast(*u8, cast(i64, dp) + pos);
            let is i32 as semi = find_char(lp, 0, llen, 59);
            if (semi >= 0) {
                let is i32 as vs with mut = semi + 1;
                let is i32 as ve with mut = llen;
                let is i32 as hh = find_char(lp, vs, llen, 35);
                if (hh >= 0) { ve = hh; }
                let is i32 as semi2 = find_char(lp, vs, ve, 59);
                if (semi2 >= 0) { ve = semi2; }
                while (vs < ve && (lp[vs] == 32 || lp[vs] == 9)) { vs = vs + 1; }
                while (ve > vs && (lp[ve - 1] == 32 || lp[ve - 1] == 9 || lp[ve - 1] == 13)) { ve = ve - 1; }
                if (slice_eq(lp, vs, ve, "Full_Composition_Exclusion") == 1) {
                    let is i32 as lo with mut = 0;
                    let is i32 as hi with mut = 0;
                    parse_range(lp, 0, semi, &lo, &hi);
                    if (lo >= 0 && hi >= lo && hi < NUMCP) {
                        let is i32 as c with mut = lo;
                        while (c <= hi) { excl[c] = cast(u8, 1); c = c + 1; }
                    }
                }
            }
        }
        pos = le + 1;
    }

    // 2. canonical length-2 decompositions that are not excluded.
    let is i32 as ulen with mut = 0;
    let is *u8 as up = slurp("tools/ucd/UnicodeData.txt", &ulen);
    if (cast(i64, up) == 0) { return cast(i32, 0 - 1); }
    let is *i64 as packed = cast(*i64, mem.core.mmap_anon(cast(i64, 4000) * 8));
    if (cast(i64, packed) == 0) { return cast(i32, 0 - 1); }
    let is i32 as npairs with mut = 0;
    pos = 0;
    while (pos < ulen) {
        let is i32 as le = line_end(up, ulen, pos);
        let is i32 as llen = le - pos;
        if (llen > 0) {
            let is *u8 as lp = cast(*u8, cast(i64, up) + pos);
            let is i32 as f0e with mut = 0;
            let is i32 as f0s = field(lp, llen, 0, &f0e);
            let is i32 as f5e with mut = 0;
            let is i32 as f5s = field(lp, llen, 5, &f5e);
            if (f0s >= 0 && f5s >= 0 && f5e > f5s) {
                let is i32 as cp = parse_hex(lp, f0s, f0e);
                let is i32 as q with mut = f5s;
                while (q < f5e && (lp[q] == 32 || lp[q] == 9)) { q = q + 1; }
                if (q < f5e && lp[q] != 60) {            // canonical (no '<tag>')
                    let is i32 as a with mut = cast(i32, 0 - 1);
                    let is i32 as b with mut = cast(i32, 0 - 1);
                    let is i32 as cnt with mut = 0;
                    while (q < f5e) {
                        while (q < f5e && (lp[q] == 32 || lp[q] == 9)) { q = q + 1; }
                        let is i32 as ts = q;
                        while (q < f5e && lp[q] != 32 && lp[q] != 9) { q = q + 1; }
                        if (q > ts) {
                            let is i32 as dcp = parse_hex(lp, ts, q);
                            if (cnt == 0) { a = dcp; }
                            if (cnt == 1) { b = dcp; }
                            cnt = cnt + 1;
                        }
                    }
                    if (cnt == 2 && cp >= 0 && cp < NUMCP && excl[cp] == 0) {
                        packed[npairs] = (cast(i64, a) << 42) | (cast(i64, b) << 21) | cast(i64, cp);
                        npairs = npairs + 1;
                    }
                }
            }
        }
        pos = le + 1;
    }

    // 3. sort by (a,b,cp) and unpack.
    qsort_i64(packed, 0, npairs - 1);
    let is *u32 as ca = cast(*u32, mem.core.mmap_anon(cast(i64, npairs) * 4));
    let is *u32 as cb = cast(*u32, mem.core.mmap_anon(cast(i64, npairs) * 4));
    let is *u32 as cc = cast(*u32, mem.core.mmap_anon(cast(i64, npairs) * 4));
    let is i32 as i with mut = 0;
    while (i < npairs) {
        let is i64 as k = packed[i];
        cc[i] = cast(u32, k & 2097151);                   // bits 0..20
        cb[i] = cast(u32, (k >> 21) & 2097151);
        ca[i] = cast(u32, (k >> 42) & 2097151);
        i = i + 1;
    }

    // 4. emit.
    let is i64 as fd = io._open_write("ucd/tables/compose.cst");
    if (fd < 0) { return cast(i32, 0 - 1); }
    let is [16384]u8 as wbuf;
    let is io.Writer as w = io.Writer(fd, cast(*u8, &wbuf), 16384);
    ws(&w, "// GENERATED by tools/gen.cst (Unicode 16.0). DO NOT EDIT.\n");
    ws(&w, "// Primary composites (a,b)->c, sorted by (a,b) for binary search.\n");
    ws(&w, "use \"../trie.cst\" as trie;\n\n");
    emit_flat_u32(&w, "compose_a", ca, npairs);
    emit_flat_u32(&w, "compose_b", cb, npairs);
    emit_flat_u32(&w, "compose_c", cc, npairs);
    ws(&w, "let is i32 as compose_count with imut = "); wi(&w, npairs); ws(&w, ";\n");
    io.flush(&w);
    io._close_fd(fd);
    io.write_str(1, "compose:  pairs="); io.write_int(1, cast(i64, npairs)); io.write_str(1, "\n");
    return 0;
}

// Build a trie from `flat` and emit it into an already-open writer (header
// and any extra blobs are the caller's responsibility). Lets one .cst file
// hold a trie plus side tables (decomposition, case, fold, ...).
fn write_trie(w as *io.Writer, name as *u8, flat as *u16, def as i32) as void {
    let is *u16 as index = cast(*u16, mem.core.mmap_anon(cast(i64, NBLOCKS) * 2));
    let is *u16 as data  = cast(*u16, mem.core.mmap_anon(cast(i64, NUMCP) * 2));
    let is i32 as dc = build_trie(flat, def, index, data);
    let is i32 as nidx = emit_u16_blob(w, name, "_index", index, NBLOCKS);
    let is i32 as ndat = emit_u16_blob(w, name, "_data", data, dc);
    emit_tail(w, name, nidx, ndat, U_MAXCP, def);
}

// ---- case properties (Cased, Case_Ignorable, Soft_Dotted as a bitset) ----

// OR `bit` into flat[range] for every "RANGE ; propname" line in p[0..len).
fn mark_prop(p as *u8, len as i32, propname as *u8, bit as i32, flat as *u16) as void {
    let is i32 as pos with mut = 0;
    while (pos < len) {
        let is i32 as le = line_end(p, len, pos);
        let is i32 as llen = le - pos;
        if (llen > 0 && p[pos] != 35) {
            let is *u8 as lp = cast(*u8, cast(i64, p) + pos);
            let is i32 as semi = find_char(lp, 0, llen, 59);
            if (semi >= 0) {
                let is i32 as vs with mut = semi + 1;
                let is i32 as ve with mut = llen;
                let is i32 as hh = find_char(lp, vs, llen, 35);
                if (hh >= 0) { ve = hh; }
                let is i32 as semi2 = find_char(lp, vs, ve, 59);
                if (semi2 >= 0) { ve = semi2; }
                while (vs < ve && (lp[vs] == 32 || lp[vs] == 9)) { vs = vs + 1; }
                while (ve > vs && (lp[ve - 1] == 32 || lp[ve - 1] == 9 || lp[ve - 1] == 13)) { ve = ve - 1; }
                if (slice_eq(lp, vs, ve, propname) == 1) {
                    let is i32 as lo with mut = 0;
                    let is i32 as hi with mut = 0;
                    parse_range(lp, 0, semi, &lo, &hi);
                    if (lo >= 0 && hi >= lo && hi < NUMCP) {
                        let is i32 as c with mut = lo;
                        while (c <= hi) { flat[c] = flat[c] | cast(u16, bit); c = c + 1; }
                    }
                }
            }
        }
        pos = le + 1;
    }
}

fn gen_caseprops() as i32 {
    let is *u16 as flat = cast(*u16, mem.core.mmap_anon(cast(i64, NUMCP) * 2));
    if (cast(i64, flat) == 0) { return cast(i32, 0 - 1); }
    let is i32 as l1 with mut = 0;
    let is *u8 as p1 = slurp("tools/ucd/DerivedCoreProperties.txt", &l1);
    if (cast(i64, p1) == 0) { return cast(i32, 0 - 1); }
    mark_prop(p1, l1, "Cased", 1, flat);
    mark_prop(p1, l1, "Case_Ignorable", 2, flat);
    let is i32 as l2 with mut = 0;
    let is *u8 as p2 = slurp("tools/ucd/PropList.txt", &l2);
    if (cast(i64, p2) == 0) { return cast(i32, 0 - 1); }
    mark_prop(p2, l2, "Soft_Dotted", 4, flat);
    io.write_str(1, "caseprops:");
    return build_and_emit("ucd/tables/caseprops.cst", "caseprops", "X", flat, 0, U_MAXCP, cast(*i64, 0), 0);
}

// ---- simple case mapping (UnicodeData fields 12/13/14) ----
// trie cp -> idx (0 = identity); vals[idx*3 + 0|1|2] = lower|upper|title.
fn gen_case_simple() as i32 {
    let is i32 as len with mut = 0;
    let is *u8 as p = slurp("tools/ucd/UnicodeData.txt", &len);
    if (cast(i64, p) == 0) { return cast(i32, 0 - 1); }
    let is *u16 as flat = cast(*u16, mem.core.mmap_anon(cast(i64, NUMCP) * 2));
    let is *u32 as vals = cast(*u32, mem.core.mmap_anon(cast(i64, 12000) * 4));
    if (cast(i64, flat) == 0 || cast(i64, vals) == 0) { return cast(i32, 0 - 1); }
    let is i32 as count with mut = 1;            // idx 0 = identity
    vals[0] = cast(u32, 0); vals[1] = cast(u32, 0); vals[2] = cast(u32, 0);
    let is i32 as pos with mut = 0;
    while (pos < len) {
        let is i32 as le = line_end(p, len, pos);
        let is i32 as llen = le - pos;
        if (llen > 0) {
            let is *u8 as lp = cast(*u8, cast(i64, p) + pos);
            let is i32 as f0e with mut = 0;
            let is i32 as f0s = field(lp, llen, 0, &f0e);
            let is i32 as fue with mut = 0;
            let is i32 as fus = field(lp, llen, 12, &fue);   // uppercase
            let is i32 as fle with mut = 0;
            let is i32 as fls = field(lp, llen, 13, &fle);   // lowercase
            let is i32 as fte with mut = 0;
            let is i32 as fts = field(lp, llen, 14, &fte);   // titlecase
            if (f0s >= 0 && fus >= 0 && fls >= 0 && fts >= 0) {
                if (fue > fus || fle > fls || fte > fts) {
                    let is i32 as cp = parse_hex(lp, f0s, f0e);
                    let is i32 as up with mut = cp;
                    let is i32 as lo with mut = cp;
                    let is i32 as ti with mut = cp;
                    if (fue > fus) { up = parse_hex(lp, fus, fue); }
                    if (fle > fls) { lo = parse_hex(lp, fls, fle); }
                    if (fte > fts) { ti = parse_hex(lp, fts, fte); }
                    if (cp >= 0 && cp < NUMCP) {
                        vals[count * 3 + 0] = cast(u32, lo);
                        vals[count * 3 + 1] = cast(u32, up);
                        vals[count * 3 + 2] = cast(u32, ti);
                        flat[cp] = cast(u16, count);
                        count = count + 1;
                    }
                }
            }
        }
        pos = le + 1;
    }
    let is i64 as fd = io._open_write("ucd/tables/simplecase.cst");
    if (fd < 0) { return cast(i32, 0 - 1); }
    let is [16384]u8 as wbuf;
    let is io.Writer as w = io.Writer(fd, cast(*u8, &wbuf), 16384);
    ws(&w, "// GENERATED by tools/gen.cst from UnicodeData.txt (Unicode 16.0). DO NOT EDIT.\n");
    ws(&w, "// trie cp -> idx (0=identity); v[idx*3+0|1|2] = simple lower|upper|title.\n");
    ws(&w, "use \"../trie.cst\" as trie;\n\n");
    write_trie(&w, "simplecase", flat, 0);
    emit_flat_u32(&w, "simplecase_v", vals, count * 3);
    io.flush(&w);
    io._close_fd(fd);
    io.write_str(1, "simplecase:  entries="); io.write_int(1, cast(i64, count)); io.write_str(1, "\n");
    return 0;
}

// ---- case folding (CaseFolding.txt) ----
// simple fold (status C/S): trie cp -> idx, v[idx] = folded cp.
// full fold   (status C/F): trie cp -> midx, meta off|len, pool of cps.
fn gen_fold() as i32 {
    let is i32 as len with mut = 0;
    let is *u8 as p = slurp("tools/ucd/CaseFolding.txt", &len);
    if (cast(i64, p) == 0) { return cast(i32, 0 - 1); }
    let is *u16 as sflat = cast(*u16, mem.core.mmap_anon(cast(i64, NUMCP) * 2));
    let is *u32 as sval  = cast(*u32, mem.core.mmap_anon(cast(i64, 2000) * 4));
    let is *u16 as fflat = cast(*u16, mem.core.mmap_anon(cast(i64, NUMCP) * 2));
    let is *u32 as fmeta = cast(*u32, mem.core.mmap_anon(cast(i64, 2000) * 4));
    let is *u32 as fpool = cast(*u32, mem.core.mmap_anon(cast(i64, 4000) * 4));
    if (cast(i64, sflat) == 0 || cast(i64, fflat) == 0) { return cast(i32, 0 - 1); }
    let is i32 as scount with mut = 1;
    sval[0] = cast(u32, 0);
    let is i32 as mcount with mut = 1;
    fmeta[0] = cast(u32, 0);
    let is i32 as pcount with mut = 0;

    let is i32 as pos with mut = 0;
    while (pos < len) {
        let is i32 as le = line_end(p, len, pos);
        let is i32 as llen = le - pos;
        if (llen > 0 && p[pos] != 35) {
            let is *u8 as lp = cast(*u8, cast(i64, p) + pos);
            let is i32 as f0e with mut = 0;
            let is i32 as f0s = field(lp, llen, 0, &f0e);
            let is i32 as f1e with mut = 0;
            let is i32 as f1s = field(lp, llen, 1, &f1e);
            let is i32 as f2e with mut = 0;
            let is i32 as f2s = field(lp, llen, 2, &f2e);
            if (f0s >= 0 && f1s >= 0 && f2s >= 0) {
                let is i32 as st with mut = f1s;
                while (st < f1e && (lp[st] == 32 || lp[st] == 9)) { st = st + 1; }
                let is u8 as status = lp[st];
                let is i32 as cp = parse_hex(lp, f0s, f0e);
                if (cp >= 0 && cp < NUMCP) {
                    if (status == 67 || status == 83) {        // 'C' or 'S' -> simple
                        let is i32 as q with mut = f2s;
                        while (q < f2e && (lp[q] == 32 || lp[q] == 9)) { q = q + 1; }
                        let is i32 as ts = q;
                        while (q < f2e && lp[q] != 32 && lp[q] != 9) { q = q + 1; }
                        sval[scount] = cast(u32, parse_hex(lp, ts, q));
                        sflat[cp] = cast(u16, scount);
                        scount = scount + 1;
                    }
                    if (status == 67 || status == 70) {        // 'C' or 'F' -> full
                        let is i32 as off = pcount;
                        let is i32 as q with mut = f2s;
                        let is i32 as flen with mut = 0;
                        while (q < f2e) {
                            while (q < f2e && (lp[q] == 32 || lp[q] == 9)) { q = q + 1; }
                            let is i32 as ts = q;
                            while (q < f2e && lp[q] != 32 && lp[q] != 9) { q = q + 1; }
                            if (q > ts) { fpool[pcount] = cast(u32, parse_hex(lp, ts, q)); pcount = pcount + 1; flen = flen + 1; }
                        }
                        fmeta[mcount] = cast(u32, off) | (cast(u32, flen) << 20);
                        fflat[cp] = cast(u16, mcount);
                        mcount = mcount + 1;
                    }
                }
            }
        }
        pos = le + 1;
    }
    let is i64 as fd = io._open_write("ucd/tables/fold.cst");
    if (fd < 0) { return cast(i32, 0 - 1); }
    let is [16384]u8 as wbuf;
    let is io.Writer as w = io.Writer(fd, cast(*u8, &wbuf), 16384);
    ws(&w, "// GENERATED by tools/gen.cst from CaseFolding.txt (Unicode 16.0). DO NOT EDIT.\n");
    ws(&w, "// foldsimple: trie cp->idx, v[idx]=folded cp. foldfull: trie cp->midx, meta off|len<<20, pool.\n");
    ws(&w, "use \"../trie.cst\" as trie;\n\n");
    write_trie(&w, "foldsimple", sflat, 0);
    emit_flat_u32(&w, "foldsimple_v", sval, scount);
    write_trie(&w, "foldfull", fflat, 0);
    emit_flat_u32(&w, "foldfull_meta", fmeta, mcount);
    emit_flat_u32(&w, "foldfull_pool", fpool, pcount);
    io.flush(&w);
    io._close_fd(fd);
    io.write_str(1, "fold:  simple="); io.write_int(1, cast(i64, scount));
    io.write_str(1, " full="); io.write_int(1, cast(i64, mcount)); io.write_str(1, "\n");
    return 0;
}

// ---- special casing (SpecialCasing.txt) ----
// Condition code: 0 unconditional, 1 Final_Sigma, 2 lt, 3 lt More_Above,
// 4 lt After_Soft_Dotted, 5 tr, 6 tr Not_Before_Dot, 7 tr After_I,
// 8 az, 9 az Not_Before_Dot, 10 az After_I.
fn parse_condition(p as *u8, s as i32, e as i32) as i32 {
    let is i32 as vs with mut = s;
    let is i32 as ve with mut = e;
    while (vs < ve && (p[vs] == 32 || p[vs] == 9)) { vs = vs + 1; }
    while (ve > vs && (p[ve - 1] == 32 || p[ve - 1] == 9 || p[ve - 1] == 13)) { ve = ve - 1; }
    if (vs >= ve) { return 0; }
    if (p[vs] == 35) { return 0; }                          // comment -> unconditional
    if (slice_eq(p, vs, ve, "Final_Sigma") == 1) { return 1; }
    if (slice_eq(p, vs, ve, "lt") == 1) { return 2; }
    if (slice_eq(p, vs, ve, "lt More_Above") == 1) { return 3; }
    if (slice_eq(p, vs, ve, "lt After_Soft_Dotted") == 1) { return 4; }
    if (slice_eq(p, vs, ve, "tr") == 1) { return 5; }
    if (slice_eq(p, vs, ve, "tr Not_Before_Dot") == 1) { return 6; }
    if (slice_eq(p, vs, ve, "tr After_I") == 1) { return 7; }
    if (slice_eq(p, vs, ve, "az") == 1) { return 8; }
    if (slice_eq(p, vs, ve, "az Not_Before_Dot") == 1) { return 9; }
    if (slice_eq(p, vs, ve, "az After_I") == 1) { return 10; }
    return cast(i32, 0 - 1);                                 // unknown -> skip
}

fn _tok_count(p as *u8, s as i32, e as i32, pool as *u32, pc as *i32) as i32 {
    let is i32 as q with mut = s;
    let is i32 as cnt with mut = 0;
    while (q < e) {
        while (q < e && (p[q] == 32 || p[q] == 9)) { q = q + 1; }
        let is i32 as ts = q;
        while (q < e && p[q] != 32 && p[q] != 9) { q = q + 1; }
        if (q > ts) {
            if (p[ts] == 35) { return cnt; }
            pool[pc[0]] = cast(u32, parse_hex(p, ts, q));
            pc[0] = pc[0] + 1;
            cnt = cnt + 1;
        }
    }
    return cnt;
}

fn gen_special() as i32 {
    let is i32 as len with mut = 0;
    let is *u8 as p = slurp("tools/ucd/SpecialCasing.txt", &len);
    if (cast(i64, p) == 0) { return cast(i32, 0 - 1); }
    let is *u32 as ecp  = cast(*u32, mem.core.mmap_anon(cast(i64, 256) * 4));
    let is *u32 as ehdr = cast(*u32, mem.core.mmap_anon(cast(i64, 256) * 4));
    let is *u32 as eoff = cast(*u32, mem.core.mmap_anon(cast(i64, 256) * 4));
    let is *u32 as pool = cast(*u32, mem.core.mmap_anon(cast(i64, 2000) * 4));
    let is *i64 as keys = cast(*i64, mem.core.mmap_anon(cast(i64, 256) * 8));
    let is i32 as ec with mut = 0;
    let is i32 as pc with mut = 0;

    let is i32 as pos with mut = 0;
    while (pos < len) {
        let is i32 as le = line_end(p, len, pos);
        let is i32 as llen = le - pos;
        if (llen > 0 && p[pos] != 35) {
            let is *u8 as lp = cast(*u8, cast(i64, p) + pos);
            let is i32 as f0e with mut = 0;
            let is i32 as f0s = field(lp, llen, 0, &f0e);
            let is i32 as f1e with mut = 0;
            let is i32 as f1s = field(lp, llen, 1, &f1e);
            let is i32 as f2e with mut = 0;
            let is i32 as f2s = field(lp, llen, 2, &f2e);
            let is i32 as f3e with mut = 0;
            let is i32 as f3s = field(lp, llen, 3, &f3e);
            let is i32 as f4e with mut = 0;
            let is i32 as f4s = field(lp, llen, 4, &f4e);
            if (f0s >= 0 && f1s >= 0 && f2s >= 0 && f3s >= 0 && f4s >= 0) {
                let is i32 as cond = parse_condition(lp, f4s, f4e);
                if (cond >= 0) {
                    let is i32 as cp = parse_hex(lp, f0s, f0e);
                    let is i32 as base = pc;
                    let is i32 as lo_len = _tok_count(lp, f1s, f1e, pool, &pc);
                    let is i32 as ti_len = _tok_count(lp, f2s, f2e, pool, &pc);
                    let is i32 as up_len = _tok_count(lp, f3s, f3e, pool, &pc);
                    ecp[ec] = cast(u32, cp);
                    ehdr[ec] = cast(u32, lo_len) | (cast(u32, ti_len) << 4) | (cast(u32, up_len) << 8) | (cast(u32, cond) << 12);
                    eoff[ec] = cast(u32, base);
                    keys[ec] = (cast(i64, cp) << 20) | cast(i64, ec);
                    ec = ec + 1;
                }
            }
        }
        pos = le + 1;
    }
    qsort_i64(keys, 0, ec - 1);
    let is *u32 as scp  = cast(*u32, mem.core.mmap_anon(cast(i64, 256) * 4));
    let is *u32 as shdr = cast(*u32, mem.core.mmap_anon(cast(i64, 256) * 4));
    let is *u32 as soff = cast(*u32, mem.core.mmap_anon(cast(i64, 256) * 4));
    let is i32 as i with mut = 0;
    while (i < ec) {
        let is i32 as src = cast(i32, keys[i] & 1048575);
        scp[i] = ecp[src]; shdr[i] = ehdr[src]; soff[i] = eoff[src];
        i = i + 1;
    }
    let is i64 as fd = io._open_write("ucd/tables/special.cst");
    if (fd < 0) { return cast(i32, 0 - 1); }
    let is [16384]u8 as wbuf;
    let is io.Writer as w = io.Writer(fd, cast(*u8, &wbuf), 16384);
    ws(&w, "// GENERATED by tools/gen.cst from SpecialCasing.txt (Unicode 16.0). DO NOT EDIT.\n");
    ws(&w, "// entries sorted by cp. hdr: lo_len(0..3) ti_len(4..7) up_len(8..11) cond(12..15).\n");
    ws(&w, "// pool layout per entry at off: [lower][title][upper].\n");
    ws(&w, "use \"../trie.cst\" as trie;\n\n");
    emit_flat_u32(&w, "sc_cp", scp, ec);
    emit_flat_u32(&w, "sc_hdr", shdr, ec);
    emit_flat_u32(&w, "sc_off", soff, ec);
    emit_flat_u32(&w, "sc_pool", pool, pc);
    ws(&w, "let is i32 as sc_count with imut = "); wi(&w, ec); ws(&w, ";\n");
    io.flush(&w);
    io._close_fd(fd);
    io.write_str(1, "special:  entries="); io.write_int(1, cast(i64, ec)); io.write_str(1, "\n");
    return 0;
}

// ---- Indic_Conjunct_Break (DerivedCoreProperties.txt, "InCB") for GB9c ----
// 3-field lines "RANGE ; InCB ; Value". Value -> 1 Consonant, 2 Extend, 3 Linker.
fn gen_incb() as i32 {
    let is *u16 as flat = cast(*u16, mem.core.mmap_anon(cast(i64, NUMCP) * 2));
    if (cast(i64, flat) == 0) { return cast(i32, 0 - 1); }
    let is i32 as len with mut = 0;
    let is *u8 as p = slurp("tools/ucd/DerivedCoreProperties.txt", &len);
    if (cast(i64, p) == 0) { return cast(i32, 0 - 1); }
    let is i32 as pos with mut = 0;
    while (pos < len) {
        let is i32 as le = line_end(p, len, pos);
        let is i32 as llen = le - pos;
        if (llen > 0 && p[pos] != 35) {
            let is *u8 as lp = cast(*u8, cast(i64, p) + pos);
            let is i32 as f1e with mut = 0;
            let is i32 as f1s = field(lp, llen, 1, &f1e);
            if (f1s >= 0) {
                let is i32 as vs1 with mut = f1s;
                let is i32 as ve1 with mut = f1e;
                while (vs1 < ve1 && (lp[vs1] == 32 || lp[vs1] == 9)) { vs1 = vs1 + 1; }
                while (ve1 > vs1 && (lp[ve1 - 1] == 32 || lp[ve1 - 1] == 9)) { ve1 = ve1 - 1; }
                if (slice_eq(lp, vs1, ve1, "InCB") == 1) {
                    let is i32 as f2e with mut = 0;
                    let is i32 as f2s = field(lp, llen, 2, &f2e);
                    let is i32 as vs with mut = f2s;
                    let is i32 as ve with mut = f2e;
                    let is i32 as hh = find_char(lp, vs, f2e, 35);
                    if (hh >= 0) { ve = hh; }
                    while (vs < ve && (lp[vs] == 32 || lp[vs] == 9)) { vs = vs + 1; }
                    while (ve > vs && (lp[ve - 1] == 32 || lp[ve - 1] == 9 || lp[ve - 1] == 13)) { ve = ve - 1; }
                    let is i32 as val with mut = 0;
                    if (slice_eq(lp, vs, ve, "Consonant") == 1) { val = 1; }
                    if (slice_eq(lp, vs, ve, "Extend") == 1) { val = 2; }
                    if (slice_eq(lp, vs, ve, "Linker") == 1) { val = 3; }
                    if (val > 0) {
                        let is i32 as f0e with mut = 0;
                        let is i32 as f0s = field(lp, llen, 0, &f0e);
                        let is i32 as lo with mut = 0;
                        let is i32 as hi with mut = 0;
                        parse_range(lp, f0s, f0e, &lo, &hi);
                        if (lo >= 0 && hi >= lo && hi < NUMCP) {
                            let is i32 as c with mut = lo;
                            while (c <= hi) { flat[c] = cast(u16, val); c = c + 1; }
                        }
                    }
                }
            }
        }
        pos = le + 1;
    }
    io.write_str(1, "incb:");
    return build_and_emit("ucd/tables/incb.cst", "incb", "INCB", flat, 0, U_MAXCP, cast(*i64, 0), 0);
}

// ---- Extended_Pictographic (emoji-data.txt) for grapheme/word breaking ----
fn gen_extpict() as i32 {
    let is *u16 as flat = cast(*u16, mem.core.mmap_anon(cast(i64, NUMCP) * 2));
    if (cast(i64, flat) == 0) { return cast(i32, 0 - 1); }
    let is i32 as l with mut = 0;
    let is *u8 as p = slurp("tools/ucd/emoji-data.txt", &l);
    if (cast(i64, p) == 0) { return cast(i32, 0 - 1); }
    mark_prop(p, l, "Extended_Pictographic", 1, flat);
    io.write_str(1, "extpict:");
    return build_and_emit("ucd/tables/extpict.cst", "extpict", "X", flat, 0, U_MAXCP, cast(*i64, 0), 0);
}

// ---- Bidi paired brackets (BidiBrackets.txt) ----
// Sorted by cp: bk_cp[i], bk_pair[i], bk_type[i] (0 open, 1 close).
fn gen_brackets() as i32 {
    let is i32 as len with mut = 0;
    let is *u8 as p = slurp("tools/ucd/BidiBrackets.txt", &len);
    if (cast(i64, p) == 0) { return cast(i32, 0 - 1); }
    let is *u32 as bcp  = cast(*u32, mem.core.mmap_anon(cast(i64, 256) * 4));
    let is *u32 as bpair = cast(*u32, mem.core.mmap_anon(cast(i64, 256) * 4));
    let is *u32 as btype = cast(*u32, mem.core.mmap_anon(cast(i64, 256) * 4));
    let is *i64 as keys = cast(*i64, mem.core.mmap_anon(cast(i64, 256) * 8));
    let is i32 as nb with mut = 0;
    let is i32 as pos with mut = 0;
    while (pos < len) {
        let is i32 as le = line_end(p, len, pos);
        let is i32 as llen = le - pos;
        if (llen > 0 && p[pos] != 35) {
            let is *u8 as lp = cast(*u8, cast(i64, p) + pos);
            let is i32 as f0e with mut = 0;
            let is i32 as f0s with mut = field(lp, llen, 0, &f0e);
            let is i32 as f1e with mut = 0;
            let is i32 as f1s with mut = field(lp, llen, 1, &f1e);
            let is i32 as f2e with mut = 0;
            let is i32 as f2s with mut = field(lp, llen, 2, &f2e);
            if (f0s >= 0 && f1s >= 0 && f2s >= 0) {
                while (f0s < f0e && (lp[f0s] == 32 || lp[f0s] == 9)) { f0s = f0s + 1; }
                while (f1s < f1e && (lp[f1s] == 32 || lp[f1s] == 9)) { f1s = f1s + 1; }
                while (f2s < f2e && (lp[f2s] == 32 || lp[f2s] == 9)) { f2s = f2s + 1; }
                let is i32 as cp = parse_hex(lp, f0s, f0e);
                let is i32 as pr = parse_hex(lp, f1s, f1e);
                let is i32 as ty with mut = 1;
                if (lp[f2s] == 111) { ty = 0; }                  // 'o' = open
                bcp[nb] = cast(u32, cp); bpair[nb] = cast(u32, pr); btype[nb] = cast(u32, ty);
                keys[nb] = (cast(i64, cp) << 20) | cast(i64, nb);
                nb = nb + 1;
            }
        }
        pos = le + 1;
    }
    qsort_i64(keys, 0, nb - 1);
    let is *u32 as scp  = cast(*u32, mem.core.mmap_anon(cast(i64, 256) * 4));
    let is *u32 as spair = cast(*u32, mem.core.mmap_anon(cast(i64, 256) * 4));
    let is *u32 as stype = cast(*u32, mem.core.mmap_anon(cast(i64, 256) * 4));
    let is i32 as i with mut = 0;
    while (i < nb) {
        let is i32 as s = cast(i32, keys[i] & 1048575);
        scp[i] = bcp[s]; spair[i] = bpair[s]; stype[i] = btype[s];
        i = i + 1;
    }
    let is i64 as fd = io._open_write("ucd/tables/brackets.cst");
    if (fd < 0) { return cast(i32, 0 - 1); }
    let is [16384]u8 as wbuf;
    let is io.Writer as w = io.Writer(fd, cast(*u8, &wbuf), 16384);
    ws(&w, "// GENERATED by tools/gen.cst from BidiBrackets.txt (Unicode 16.0). DO NOT EDIT.\n");
    ws(&w, "use \"../trie.cst\" as trie;\n\n");
    emit_flat_u32(&w, "bk_cp", scp, nb);
    emit_flat_u32(&w, "bk_pair", spair, nb);
    emit_flat_u32(&w, "bk_type", stype, nb);
    ws(&w, "let is i32 as bk_count with imut = "); wi(&w, nb); ws(&w, ";\n");
    io.flush(&w);
    io._close_fd(fd);
    io.write_str(1, "brackets:  pairs="); io.write_int(1, cast(i64, nb)); io.write_str(1, "\n");
    return 0;
}

// ---- Bidi mirroring (BidiMirroring.txt) ----  sorted mr_cp[i] -> mr_to[i].
fn gen_mirror() as i32 {
    let is i32 as len with mut = 0;
    let is *u8 as p = slurp("tools/ucd/BidiMirroring.txt", &len);
    if (cast(i64, p) == 0) { return cast(i32, 0 - 1); }
    let is *u32 as mcp = cast(*u32, mem.core.mmap_anon(cast(i64, 1024) * 4));
    let is *u32 as mto = cast(*u32, mem.core.mmap_anon(cast(i64, 1024) * 4));
    let is *i64 as keys = cast(*i64, mem.core.mmap_anon(cast(i64, 1024) * 8));
    let is i32 as nm with mut = 0;
    let is i32 as pos with mut = 0;
    while (pos < len) {
        let is i32 as le = line_end(p, len, pos);
        let is i32 as llen = le - pos;
        if (llen > 0 && p[pos] != 35) {
            let is *u8 as lp = cast(*u8, cast(i64, p) + pos);
            let is i32 as f0e with mut = 0;
            let is i32 as f0s with mut = field(lp, llen, 0, &f0e);
            let is i32 as f1e with mut = 0;
            let is i32 as f1s with mut = field(lp, llen, 1, &f1e);
            if (f0s >= 0 && f1s >= 0) {
                while (f0s < f0e && (lp[f0s] == 32 || lp[f0s] == 9)) { f0s = f0s + 1; }
                while (f1s < f1e && (lp[f1s] == 32 || lp[f1s] == 9)) { f1s = f1s + 1; }
                let is i32 as he = find_char(lp, f1s, f1e, 35);
                if (he >= 0) { f1e = he; }
                while (f1e > f1s && (lp[f1e - 1] == 32 || lp[f1e - 1] == 9)) { f1e = f1e - 1; }
                let is i32 as cp = parse_hex(lp, f0s, f0e);
                let is i32 as to = parse_hex(lp, f1s, f1e);
                mcp[nm] = cast(u32, cp); mto[nm] = cast(u32, to);
                keys[nm] = (cast(i64, cp) << 20) | cast(i64, nm);
                nm = nm + 1;
            }
        }
        pos = le + 1;
    }
    qsort_i64(keys, 0, nm - 1);
    let is *u32 as scp = cast(*u32, mem.core.mmap_anon(cast(i64, 1024) * 4));
    let is *u32 as sto = cast(*u32, mem.core.mmap_anon(cast(i64, 1024) * 4));
    let is i32 as i with mut = 0;
    while (i < nm) {
        let is i32 as s = cast(i32, keys[i] & 1048575);
        scp[i] = mcp[s]; sto[i] = mto[s];
        i = i + 1;
    }
    let is i64 as fd = io._open_write("ucd/tables/mirror.cst");
    if (fd < 0) { return cast(i32, 0 - 1); }
    let is [16384]u8 as wbuf;
    let is io.Writer as w = io.Writer(fd, cast(*u8, &wbuf), 16384);
    ws(&w, "// GENERATED by tools/gen.cst from BidiMirroring.txt (Unicode 16.0). DO NOT EDIT.\n");
    ws(&w, "use \"../trie.cst\" as trie;\n\n");
    emit_flat_u32(&w, "mr_cp", scp, nm);
    emit_flat_u32(&w, "mr_to", sto, nm);
    ws(&w, "let is i32 as mr_count with imut = "); wi(&w, nm); ws(&w, ";\n");
    io.flush(&w);
    io._close_fd(fd);
    io.write_str(1, "mirror:  pairs="); io.write_int(1, cast(i64, nm)); io.write_str(1, "\n");
    return 0;
}

// ---- IDNA / UTS #46 mapping (IdnaMappingTable.txt) ----
// trie cp -> meta idx. meta packed u32: off(0..19) len(20..27) status(28..31).
// status: 0 valid, 1 mapped, 2 deviation, 3 disallowed, 4 ignored.
// idx 0 = valid (default); 1 = disallowed; 2 = ignored (shared, no mapping).
fn gen_idna() as i32 {
    let is i32 as len with mut = 0;
    let is *u8 as p = slurp("tools/ucd/IdnaMappingTable.txt", &len);
    if (cast(i64, p) == 0) { return cast(i32, 0 - 1); }
    let is *u16 as flat = cast(*u16, mem.core.mmap_anon(cast(i64, NUMCP) * 2));
    let is *u32 as meta = cast(*u32, mem.core.mmap_anon(cast(i64, 12000) * 4));
    let is *u32 as pool = cast(*u32, mem.core.mmap_anon(cast(i64, 16000) * 4));
    if (cast(i64, flat) == 0 || cast(i64, meta) == 0 || cast(i64, pool) == 0) { return cast(i32, 0 - 1); }
    meta[0] = cast(u32, 0);                              // valid
    meta[1] = cast(u32, 3) << 28;                        // disallowed
    meta[2] = cast(u32, 4) << 28;                        // ignored
    let is i32 as mcount with mut = 3;
    let is i32 as pcount with mut = 0;

    let is i32 as pos with mut = 0;
    while (pos < len) {
        let is i32 as le = line_end(p, len, pos);
        let is i32 as llen = le - pos;
        if (llen > 0 && p[pos] != 35) {
            let is *u8 as lp = cast(*u8, cast(i64, p) + pos);
            let is i32 as f0e with mut = 0;
            let is i32 as f0s = field(lp, llen, 0, &f0e);
            let is i32 as f1e with mut = 0;
            let is i32 as f1s = field(lp, llen, 1, &f1e);
            if (f0s >= 0 && f1s >= 0) {
                let is i32 as lo with mut = 0;
                let is i32 as hi with mut = 0;
                parse_range(lp, f0s, f0e, &lo, &hi);
                let is i32 as vs with mut = f1s;
                let is i32 as ve with mut = f1e;
                let is i32 as hsh = find_char(lp, vs, ve, 35);
                if (hsh >= 0) { ve = hsh; }                       // drop trailing comment
                while (vs < ve && (lp[vs] == 32 || lp[vs] == 9)) { vs = vs + 1; }
                while (ve > vs && (lp[ve - 1] == 32 || lp[ve - 1] == 9)) { ve = ve - 1; }
                let is i32 as idx with mut = 0;
                if (slice_eq(lp, vs, ve, "valid") == 1) { idx = 0; }
                else if (slice_eq(lp, vs, ve, "disallowed") == 1) { idx = 1; }
                else if (slice_eq(lp, vs, ve, "ignored") == 1) { idx = 2; }
                else {
                    let is i32 as status with mut = 1;            // mapped
                    if (slice_eq(lp, vs, ve, "deviation") == 1) { status = 2; }
                    // mapping = field 2 (hex tokens, may be empty for deviation)
                    let is i32 as f2e with mut = 0;
                    let is i32 as f2s = field(lp, llen, 2, &f2e);
                    let is i32 as off = pcount;
                    let is i32 as ln with mut = 0;
                    if (f2s >= 0) {
                        let is i32 as q with mut = f2s;
                        while (q < f2e) {
                            while (q < f2e && (lp[q] == 32 || lp[q] == 9)) { q = q + 1; }
                            let is i32 as ts = q;
                            while (q < f2e && lp[q] != 32 && lp[q] != 9) { q = q + 1; }
                            if (q > ts) {
                                if (lp[ts] == 35) { q = f2e; }
                                else { pool[pcount] = cast(u32, parse_hex(lp, ts, q)); pcount = pcount + 1; ln = ln + 1; }
                            }
                        }
                    }
                    meta[mcount] = cast(u32, off) | (cast(u32, ln) << 20) | (cast(u32, status) << 28);
                    idx = mcount;
                    mcount = mcount + 1;
                }
                if (lo >= 0 && hi >= lo && hi < NUMCP && idx != 0) {
                    let is i32 as c with mut = lo;
                    while (c <= hi) { flat[c] = cast(u16, idx); c = c + 1; }
                }
            }
        }
        pos = le + 1;
    }
    let is *u16 as index = cast(*u16, mem.core.mmap_anon(cast(i64, NBLOCKS) * 2));
    let is *u16 as data  = cast(*u16, mem.core.mmap_anon(cast(i64, NUMCP) * 2));
    let is i32 as dc = build_trie(flat, 0, index, data);
    let is i64 as fd = io._open_write("ucd/tables/idna.cst");
    if (fd < 0) { return cast(i32, 0 - 1); }
    let is [16384]u8 as wbuf;
    let is io.Writer as w = io.Writer(fd, cast(*u8, &wbuf), 16384);
    ws(&w, "// GENERATED by tools/gen.cst from IdnaMappingTable.txt (Unicode 16.0). DO NOT EDIT.\n");
    ws(&w, "// trie cp -> meta idx; meta u32: off(0..19) len(20..27) status(28..31).\n");
    ws(&w, "// status: 0 valid, 1 mapped, 2 deviation, 3 disallowed, 4 ignored.\n");
    ws(&w, "use \"../trie.cst\" as trie;\n\n");
    let is i32 as nidx = emit_u16_blob(&w, "idna", "_index", index, NBLOCKS);
    let is i32 as ndat = emit_u16_blob(&w, "idna", "_data", data, dc);
    emit_tail(&w, "idna", nidx, ndat, U_MAXCP, 0);
    emit_flat_u32(&w, "idna_meta", meta, mcount);
    emit_flat_u32(&w, "idna_pool", pool, pcount);
    io.flush(&w);
    io._close_fd(fd);
    io.write_str(1, "idna:  meta="); io.write_int(1, cast(i64, mcount));
    io.write_str(1, " pool="); io.write_int(1, cast(i64, pcount)); io.write_str(1, "\n");
    return 0;
}

// ---- Unified_Ideograph (PropList.txt) for UCA implicit weights ----
fn gen_uideo() as i32 {
    let is *u16 as flat = cast(*u16, mem.core.mmap_anon(cast(i64, NUMCP) * 2));
    if (cast(i64, flat) == 0) { return cast(i32, 0 - 1); }
    let is i32 as l with mut = 0;
    let is *u8 as p = slurp("tools/ucd/PropList.txt", &l);
    if (cast(i64, p) == 0) { return cast(i32, 0 - 1); }
    mark_prop(p, l, "Unified_Ideograph", 1, flat);
    io.write_str(1, "uideo:");
    return build_and_emit("ucd/tables/uideo.cst", "uideo", "X", flat, 0, U_MAXCP, cast(*i64, 0), 0);
}

// Read a hex field; advance *q to the terminator.
fn _hexf(p as *u8, q as *i32, end as i32) as i32 {
    let is i32 as v with mut = 0;
    while (q[0] < end && hexval(p[q[0]]) >= 0) { v = (v << 4) | hexval(p[q[0]]); q[0] = q[0] + 1; }
    return v;
}

// Parse the collation-element list "[.PPPP.SSSS.TTTT]..." in p[s..e). Appends
// to the CE pool (2 u32 per CE: prim|var<<16, sec|ter<<16). Returns CE count.
fn _parse_ces(p as *u8, s as i32, e as i32, pool as *u32, pc as *i32) as i32 {
    let is i32 as q with mut = s;
    let is i32 as count with mut = 0;
    while (q < e) {
        while (q < e && p[q] != 91) { q = q + 1; }       // '['
        if (q >= e) { return count; }
        q = q + 1;
        let is i32 as var with mut = 0;
        if (p[q] == 42) { var = 1; }                     // '*'
        q = q + 1;
        let is i32 as prim = _hexf(p, &q, e);
        if (q < e && p[q] == 46) { q = q + 1; }          // '.'
        let is i32 as sec = _hexf(p, &q, e);
        if (q < e && p[q] == 46) { q = q + 1; }
        let is i32 as ter = _hexf(p, &q, e);
        pool[pc[0]] = cast(u32, prim) | (cast(u32, var) << 16);
        pool[pc[0] + 1] = cast(u32, sec) | (cast(u32, ter) << 16);
        pc[0] = pc[0] + 2;
        count = count + 1;
    }
    return count;
}

// ---- DUCET / UCA collation table (allkeys.txt) ----
fn gen_collate() as i32 {
    let is i32 as len with mut = 0;
    let is *u8 as p = slurp("tools/ucd/allkeys.txt", &len);
    if (cast(i64, p) == 0) { return cast(i32, 0 - 1); }
    let is *u16 as flat = cast(*u16, mem.core.mmap_anon(cast(i64, NUMCP) * 2));   // cp -> meta idx
    let is *u32 as meta = cast(*u32, mem.core.mmap_anon(cast(i64, 40000) * 4));   // off(0..23)|len(24..31)
    let is *u32 as pool = cast(*u32, mem.core.mmap_anon(cast(i64, 120000) * 4));  // 2 u32 per CE
    if (cast(i64, flat) == 0 || cast(i64, meta) == 0 || cast(i64, pool) == 0) { return cast(i32, 0 - 1); }
    // contraction arrays
    let is *u32 as cc0 = cast(*u32, mem.core.mmap_anon(cast(i64, 2048) * 4));
    let is *u32 as cc1 = cast(*u32, mem.core.mmap_anon(cast(i64, 2048) * 4));
    let is *u32 as cc2 = cast(*u32, mem.core.mmap_anon(cast(i64, 2048) * 4));
    let is *u32 as ccoff = cast(*u32, mem.core.mmap_anon(cast(i64, 2048) * 4));
    let is *u32 as cclen = cast(*u32, mem.core.mmap_anon(cast(i64, 2048) * 4));
    let is *i64 as cckey = cast(*i64, mem.core.mmap_anon(cast(i64, 2048) * 8));
    let is i32 as mcount with mut = 1;      // meta idx 0 = not in DUCET (implicit weight)
    meta[0] = cast(u32, 0);
    let is i32 as pc with mut = 0;
    let is i32 as nct with mut = 0;

    let is i32 as pos with mut = 0;
    while (pos < len) {
        let is i32 as le = line_end(p, len, pos);
        let is i32 as llen = le - pos;
        if (llen > 0 && p[pos] != 35 && p[pos] != 64) {     // skip '#' and '@'
            let is *u8 as lp = cast(*u8, cast(i64, p) + pos);
            let is i32 as semi = find_char(lp, 0, llen, 59);
            if (semi >= 0) {
                // parse the code points before ';'
                let is i32 as c0 with mut = cast(i32, 0 - 1);
                let is i32 as c1 with mut = cast(i32, 0 - 1);
                let is i32 as c2 with mut = cast(i32, 0 - 1);
                let is i32 as ncp with mut = 0;
                let is i32 as q with mut = 0;
                while (q < semi) {
                    while (q < semi && (lp[q] == 32 || lp[q] == 9)) { q = q + 1; }
                    let is i32 as ts = q;
                    while (q < semi && lp[q] != 32 && lp[q] != 9) { q = q + 1; }
                    if (q > ts) {
                        let is i32 as cv = parse_hex(lp, ts, q);
                        if (ncp == 0) { c0 = cv; } else if (ncp == 1) { c1 = cv; } else if (ncp == 2) { c2 = cv; }
                        ncp = ncp + 1;
                    }
                }
                // CE end = '#' or line end
                let is i32 as ce_end with mut = llen;
                let is i32 as hh = find_char(lp, semi, llen, 35);
                if (hh >= 0) { ce_end = hh; }
                let is i32 as off = pc / 2;
                let is i32 as nce = _parse_ces(lp, semi + 1, ce_end, pool, &pc);
                if (ncp == 1 && c0 >= 0 && c0 < NUMCP) {
                    meta[mcount] = cast(u32, off) | (cast(u32, nce) << 24);
                    flat[c0] = cast(u16, mcount);
                    mcount = mcount + 1;
                } else if (ncp >= 2 && nct < 2048) {
                    cc0[nct] = cast(u32, c0); cc1[nct] = cast(u32, c1);
                    if (ncp >= 3) { cc2[nct] = cast(u32, c2); } else { cc2[nct] = cast(u32, 2147483647); }
                    ccoff[nct] = cast(u32, off); cclen[nct] = cast(u32, nce);
                    let is i64 as k2 with mut = 0;
                    if (ncp >= 3) { k2 = cast(i64, c2); }
                    cckey[nct] = (cast(i64, c0) << 42) | (cast(i64, c1) << 21) | k2;
                    nct = nct + 1;
                }
            }
        }
        pos = le + 1;
    }

    // sort contractions by (c0,c1,c2) via key permutation (insertion sort)
    let is *u32 as ord = cast(*u32, mem.core.mmap_anon(cast(i64, 2048) * 4));
    let is i32 as a with mut = 0;
    while (a < nct) { ord[a] = cast(u32, a); a = a + 1; }
    a = 1;
    while (a < nct) {
        let is i32 as oa = cast(i32, ord[a]);
        let is i64 as ka = cckey[oa];
        let is i32 as b with mut = a - 1;
        while (b >= 0 && cckey[cast(i32, ord[b])] > ka) { ord[b + 1] = ord[b]; b = b - 1; }
        ord[b + 1] = cast(u32, oa);
        a = a + 1;
    }
    let is *u32 as s0 = cast(*u32, mem.core.mmap_anon(cast(i64, 2048) * 4));
    let is *u32 as s1 = cast(*u32, mem.core.mmap_anon(cast(i64, 2048) * 4));
    let is *u32 as s2 = cast(*u32, mem.core.mmap_anon(cast(i64, 2048) * 4));
    let is *u32 as soff = cast(*u32, mem.core.mmap_anon(cast(i64, 2048) * 4));
    let is *u32 as slen = cast(*u32, mem.core.mmap_anon(cast(i64, 2048) * 4));
    a = 0;
    while (a < nct) {
        let is i32 as o = cast(i32, ord[a]);
        s0[a] = cc0[o]; s1[a] = cc1[o]; s2[a] = cc2[o]; soff[a] = ccoff[o]; slen[a] = cclen[o];
        a = a + 1;
    }

    let is *u16 as index = cast(*u16, mem.core.mmap_anon(cast(i64, NBLOCKS) * 2));
    let is *u16 as data  = cast(*u16, mem.core.mmap_anon(cast(i64, NUMCP) * 2));
    let is i32 as dc = build_trie(flat, 0, index, data);
    let is i64 as fd = io._open_write("ucd/tables/collate.cst");
    if (fd < 0) { return cast(i32, 0 - 1); }
    let is [16384]u8 as wbuf;
    let is io.Writer as w = io.Writer(fd, cast(*u8, &wbuf), 16384);
    ws(&w, "// GENERATED by tools/gen.cst from allkeys.txt (UCA 16.0). DO NOT EDIT.\n");
    ws(&w, "// trie cp->meta idx (0=implicit). meta u32: off(0..23) len(24..31) in CE units.\n");
    ws(&w, "// CE pool: 2 u32 per CE = (prim|var<<16, sec|ter<<16). Contractions sorted by (c0,c1,c2).\n");
    ws(&w, "use \"../trie.cst\" as trie;\n\n");
    let is i32 as nidx = emit_u16_blob(&w, "collate", "_index", index, NBLOCKS);
    let is i32 as ndat = emit_u16_blob(&w, "collate", "_data", data, dc);
    emit_tail(&w, "collate", nidx, ndat, U_MAXCP, 0);
    emit_flat_u32(&w, "collate_meta", meta, mcount);
    emit_flat_u32(&w, "collate_pool", pool, pc);
    emit_flat_u32(&w, "collate_c0", s0, nct);
    emit_flat_u32(&w, "collate_c1", s1, nct);
    emit_flat_u32(&w, "collate_c2", s2, nct);
    emit_flat_u32(&w, "collate_coff", soff, nct);
    emit_flat_u32(&w, "collate_clen", slen, nct);
    ws(&w, "let is i32 as collate_nct with imut = "); wi(&w, nct); ws(&w, ";\n");
    io.flush(&w);
    io._close_fd(fd);
    io.write_str(1, "collate:  singles="); io.write_int(1, cast(i64, mcount));
    io.write_str(1, " ces="); io.write_int(1, cast(i64, pc / 2));
    io.write_str(1, " contractions="); io.write_int(1, cast(i64, nct)); io.write_str(1, "\n");
    return 0;
}

// ---- WHATWG single-byte encodings ----
// One combined table sb[id*128 + (byte-0x80)] = cp (0x110000 = unmapped).
fn _sb_fill(path as *u8, id as i32, table as *u32) as void {
    let is i32 as len with mut = 0;
    let is *u8 as p = slurp(path, &len);
    if (cast(i64, p) == 0) { io.write_str(1, "missing "); io.write_str(1, path); io.write_str(1, "\n"); return; }
    let is i32 as pos with mut = 0;
    while (pos < len) {
        let is i32 as le = line_end(p, len, pos);
        let is i32 as llen = le - pos;
        if (llen > 0 && p[pos] != 35) {
            let is *u8 as lp = cast(*u8, cast(i64, p) + pos);
            let is i32 as q with mut = 0;
            while (q < llen && (lp[q] == 32 || lp[q] == 9)) { q = q + 1; }
            let is i32 as ds = q;
            while (q < llen && lp[q] >= 48 && lp[q] <= 57) { q = q + 1; }
            if (q > ds) {
                let is i32 as ptr = parse_dec(lp, ds, q);
                let is i32 as xx = find_substr(lp, q, llen, "0x");
                if (xx >= 0 && ptr >= 0 && ptr < 128) {
                    let is i32 as hs = xx + 2;
                    let is i32 as he with mut = hs;
                    while (he < llen && hexval(lp[he]) >= 0) { he = he + 1; }
                    table[id * 128 + ptr] = cast(u32, parse_hex(lp, hs, he));
                }
            }
        }
        pos = le + 1;
    }
}

fn gen_sbcs() as i32 {
    let is *u32 as t = cast(*u32, mem.core.mmap_anon(cast(i64, 27 * 128) * 4));
    if (cast(i64, t) == 0) { return cast(i32, 0 - 1); }
    let is i32 as i with mut = 0;
    while (i < 27 * 128) { t[i] = cast(u32, 1114112); i = i + 1; }   // 0x110000 = unmapped
    _sb_fill("tools/ucd/whatwg/index-ibm866.txt", 0, t);
    _sb_fill("tools/ucd/whatwg/index-iso-8859-2.txt", 1, t);
    _sb_fill("tools/ucd/whatwg/index-iso-8859-3.txt", 2, t);
    _sb_fill("tools/ucd/whatwg/index-iso-8859-4.txt", 3, t);
    _sb_fill("tools/ucd/whatwg/index-iso-8859-5.txt", 4, t);
    _sb_fill("tools/ucd/whatwg/index-iso-8859-6.txt", 5, t);
    _sb_fill("tools/ucd/whatwg/index-iso-8859-7.txt", 6, t);
    _sb_fill("tools/ucd/whatwg/index-iso-8859-8.txt", 7, t);
    _sb_fill("tools/ucd/whatwg/index-iso-8859-10.txt", 8, t);
    _sb_fill("tools/ucd/whatwg/index-iso-8859-13.txt", 9, t);
    _sb_fill("tools/ucd/whatwg/index-iso-8859-14.txt", 10, t);
    _sb_fill("tools/ucd/whatwg/index-iso-8859-15.txt", 11, t);
    _sb_fill("tools/ucd/whatwg/index-iso-8859-16.txt", 12, t);
    _sb_fill("tools/ucd/whatwg/index-koi8-r.txt", 13, t);
    _sb_fill("tools/ucd/whatwg/index-koi8-u.txt", 14, t);
    _sb_fill("tools/ucd/whatwg/index-macintosh.txt", 15, t);
    _sb_fill("tools/ucd/whatwg/index-windows-874.txt", 16, t);
    _sb_fill("tools/ucd/whatwg/index-windows-1250.txt", 17, t);
    _sb_fill("tools/ucd/whatwg/index-windows-1251.txt", 18, t);
    _sb_fill("tools/ucd/whatwg/index-windows-1252.txt", 19, t);
    _sb_fill("tools/ucd/whatwg/index-windows-1253.txt", 20, t);
    _sb_fill("tools/ucd/whatwg/index-windows-1254.txt", 21, t);
    _sb_fill("tools/ucd/whatwg/index-windows-1255.txt", 22, t);
    _sb_fill("tools/ucd/whatwg/index-windows-1256.txt", 23, t);
    _sb_fill("tools/ucd/whatwg/index-windows-1257.txt", 24, t);
    _sb_fill("tools/ucd/whatwg/index-windows-1258.txt", 25, t);
    _sb_fill("tools/ucd/whatwg/index-x-mac-cyrillic.txt", 26, t);

    let is i64 as fd = io._open_write("ucd/tables/sbcs.cst");
    if (fd < 0) { return cast(i32, 0 - 1); }
    let is [16384]u8 as wbuf;
    let is io.Writer as w = io.Writer(fd, cast(*u8, &wbuf), 16384);
    ws(&w, "// GENERATED by tools/gen.cst from WHATWG single-byte indexes. DO NOT EDIT.\n");
    ws(&w, "// sb[id*128 + (byte-0x80)] = cp (1114112 = unmapped).\n");
    ws(&w, "use \"../trie.cst\" as trie;\n\n");
    emit_flat_u32(&w, "sb", t, 27 * 128);
    ws(&w, "let is i32 as ENC_IBM866 with imut = 0;\n");
    ws(&w, "let is i32 as ENC_ISO_8859_2 with imut = 1;\nlet is i32 as ENC_ISO_8859_3 with imut = 2;\n");
    ws(&w, "let is i32 as ENC_ISO_8859_4 with imut = 3;\nlet is i32 as ENC_ISO_8859_5 with imut = 4;\n");
    ws(&w, "let is i32 as ENC_ISO_8859_6 with imut = 5;\nlet is i32 as ENC_ISO_8859_7 with imut = 6;\n");
    ws(&w, "let is i32 as ENC_ISO_8859_8 with imut = 7;\nlet is i32 as ENC_ISO_8859_10 with imut = 8;\n");
    ws(&w, "let is i32 as ENC_ISO_8859_13 with imut = 9;\nlet is i32 as ENC_ISO_8859_14 with imut = 10;\n");
    ws(&w, "let is i32 as ENC_ISO_8859_15 with imut = 11;\nlet is i32 as ENC_ISO_8859_16 with imut = 12;\n");
    ws(&w, "let is i32 as ENC_KOI8_R with imut = 13;\nlet is i32 as ENC_KOI8_U with imut = 14;\n");
    ws(&w, "let is i32 as ENC_MACINTOSH with imut = 15;\nlet is i32 as ENC_WINDOWS_874 with imut = 16;\n");
    ws(&w, "let is i32 as ENC_WINDOWS_1250 with imut = 17;\nlet is i32 as ENC_WINDOWS_1251 with imut = 18;\n");
    ws(&w, "let is i32 as ENC_WINDOWS_1252 with imut = 19;\nlet is i32 as ENC_WINDOWS_1253 with imut = 20;\n");
    ws(&w, "let is i32 as ENC_WINDOWS_1254 with imut = 21;\nlet is i32 as ENC_WINDOWS_1255 with imut = 22;\n");
    ws(&w, "let is i32 as ENC_WINDOWS_1256 with imut = 23;\nlet is i32 as ENC_WINDOWS_1257 with imut = 24;\n");
    ws(&w, "let is i32 as ENC_WINDOWS_1258 with imut = 25;\nlet is i32 as ENC_X_MAC_CYRILLIC with imut = 26;\n");
    io.flush(&w);
    io._close_fd(fd);
    io.write_str(1, "sbcs:  27 single-byte encodings\n");
    return 0;
}

// Load a WHATWG multi-byte index (pointer<dec> \t 0x<cp>) into arr (sentinel
// 1114112 for gaps). Returns size (max pointer + 1).
fn _mb_load(path as *u8, arr as *u32, cap as i32) as i32 {
    let is i32 as i with mut = 0;
    while (i < cap) { arr[i] = cast(u32, 1114112); i = i + 1; }
    let is i32 as len with mut = 0;
    let is *u8 as p = slurp(path, &len);
    if (cast(i64, p) == 0) { io.write_str(1, "missing "); io.write_str(1, path); io.write_str(1, "\n"); return 0; }
    let is i32 as size with mut = 0;
    let is i32 as pos with mut = 0;
    while (pos < len) {
        let is i32 as le = line_end(p, len, pos);
        let is i32 as llen = le - pos;
        if (llen > 0 && p[pos] != 35) {
            let is *u8 as lp = cast(*u8, cast(i64, p) + pos);
            let is i32 as q with mut = 0;
            while (q < llen && (lp[q] == 32 || lp[q] == 9)) { q = q + 1; }
            let is i32 as ds = q;
            while (q < llen && lp[q] >= 48 && lp[q] <= 57) { q = q + 1; }
            if (q > ds) {
                let is i32 as ptr = parse_dec(lp, ds, q);
                let is i32 as xx = find_substr(lp, q, llen, "0x");
                if (xx >= 0 && ptr >= 0 && ptr < cap) {
                    let is i32 as hs = xx + 2;
                    let is i32 as he with mut = hs;
                    while (he < llen && hexval(lp[he]) >= 0) { he = he + 1; }
                    arr[ptr] = cast(u32, parse_hex(lp, hs, he));
                    if (ptr + 1 > size) { size = ptr + 1; }
                }
            }
        }
        pos = le + 1;
    }
    return size;
}

// Load (pointer<dec> \t 0x<cp>) pairs into rp/rc in file order. Returns count.
fn _mb_load_pairs(path as *u8, rp as *u32, rc as *u32, cap as i32) as i32 {
    let is i32 as len with mut = 0;
    let is *u8 as p = slurp(path, &len);
    if (cast(i64, p) == 0) { return 0; }
    let is i32 as n with mut = 0;
    let is i32 as pos with mut = 0;
    while (pos < len && n < cap) {
        let is i32 as le = line_end(p, len, pos);
        let is i32 as llen = le - pos;
        if (llen > 0 && p[pos] != 35) {
            let is *u8 as lp = cast(*u8, cast(i64, p) + pos);
            let is i32 as q with mut = 0;
            while (q < llen && (lp[q] == 32 || lp[q] == 9)) { q = q + 1; }
            let is i32 as ds = q;
            while (q < llen && lp[q] >= 48 && lp[q] <= 57) { q = q + 1; }
            if (q > ds) {
                let is i32 as xx = find_substr(lp, q, llen, "0x");
                if (xx >= 0) {
                    let is i32 as hs = xx + 2;
                    let is i32 as he with mut = hs;
                    while (he < llen && hexval(lp[he]) >= 0) { he = he + 1; }
                    rp[n] = cast(u32, parse_dec(lp, ds, q));
                    rc[n] = cast(u32, parse_hex(lp, hs, he));
                    n = n + 1;
                }
            }
        }
        pos = le + 1;
    }
    return n;
}

// Build a reverse map cp -> pointer (sorted by cp) from a forward index.
// prefer_last=1 keeps the last pointer for a cp (Big5), else the first.
fn _mb_reverse(fwd as *u32, size as i32, prefer_last as i32, rcp as *u32, rptr as *u32, cap as i32) as i32 {
    let is *u32 as rev = cast(*u32, mem.core.mmap_anon(cast(i64, 1114112) * 4));
    let is i32 as i with mut = 0;
    while (i < 1114112) { rev[i] = cast(u32, 2147483647); i = i + 1; }
    let is i32 as p with mut = 0;
    while (p < size) {
        let is i32 as cp = cast(i32, fwd[p]);
        if (cp != 1114112 && cp >= 0 && cp < 1114112) {
            if (prefer_last == 1) { rev[cp] = cast(u32, p); }
            else { if (rev[cp] == cast(u32, 2147483647)) { rev[cp] = cast(u32, p); } }
        }
        p = p + 1;
    }
    let is i32 as cnt with mut = 0;
    let is i32 as cp2 with mut = 0;
    while (cp2 < 1114112) {
        if (rev[cp2] != cast(u32, 2147483647) && cnt < cap) { rcp[cnt] = cast(u32, cp2); rptr[cnt] = rev[cp2]; cnt = cnt + 1; }
        cp2 = cp2 + 1;
    }
    return cnt;
}

fn gen_mbcs() as i32 {
    let is *u32 as jis = cast(*u32, mem.core.mmap_anon(cast(i64, 12000) * 4));
    let is *u32 as big = cast(*u32, mem.core.mmap_anon(cast(i64, 20000) * 4));
    let is *u32 as euk = cast(*u32, mem.core.mmap_anon(cast(i64, 24000) * 4));
    let is *u32 as gbk = cast(*u32, mem.core.mmap_anon(cast(i64, 24000) * 4));
    if (cast(i64, jis) == 0 || cast(i64, big) == 0 || cast(i64, euk) == 0 || cast(i64, gbk) == 0) { return cast(i32, 0 - 1); }
    let is i32 as nj = _mb_load("tools/ucd/whatwg/index-jis0208.txt", jis, 12000);
    let is i32 as nb = _mb_load("tools/ucd/whatwg/index-big5.txt", big, 20000);
    let is i32 as nk = _mb_load("tools/ucd/whatwg/index-euc-kr.txt", euk, 24000);
    let is i32 as ng = _mb_load("tools/ucd/whatwg/index-gb18030.txt", gbk, 24000);
    let is *u32 as j212 = cast(*u32, mem.core.mmap_anon(cast(i64, 12000) * 4));
    let is i32 as n212 = _mb_load("tools/ucd/whatwg/index-jis0212.txt", j212, 12000);
    // gb18030 ranges (pointer -> starting cp), already ascending by pointer
    let is *u32 as rp = cast(*u32, mem.core.mmap_anon(cast(i64, 512) * 4));
    let is *u32 as rc = cast(*u32, mem.core.mmap_anon(cast(i64, 512) * 4));
    let is i32 as nr = _mb_load_pairs("tools/ucd/whatwg/index-gb18030-ranges.txt", rp, rc, 512);
    // reverse maps for encoding
    let is *u32 as rjc = cast(*u32, mem.core.mmap_anon(cast(i64, 16000) * 4));
    let is *u32 as rjp = cast(*u32, mem.core.mmap_anon(cast(i64, 16000) * 4));
    let is i32 as nrj = _mb_reverse(jis, nj, 0, rjc, rjp, 16000);
    let is *u32 as rbc = cast(*u32, mem.core.mmap_anon(cast(i64, 20000) * 4));
    let is *u32 as rbp = cast(*u32, mem.core.mmap_anon(cast(i64, 20000) * 4));
    let is i32 as nrb = _mb_reverse(big, nb, 1, rbc, rbp, 20000);
    let is *u32 as rkc = cast(*u32, mem.core.mmap_anon(cast(i64, 20000) * 4));
    let is *u32 as rkp = cast(*u32, mem.core.mmap_anon(cast(i64, 20000) * 4));
    let is i32 as nrk = _mb_reverse(euk, nk, 0, rkc, rkp, 20000);
    let is *u32 as rgc = cast(*u32, mem.core.mmap_anon(cast(i64, 24000) * 4));
    let is *u32 as rgp = cast(*u32, mem.core.mmap_anon(cast(i64, 24000) * 4));
    let is i32 as nrg = _mb_reverse(gbk, ng, 0, rgc, rgp, 24000);

    let is i64 as fd = io._open_write("ucd/tables/mbcs.cst");
    if (fd < 0) { return cast(i32, 0 - 1); }
    let is [16384]u8 as wbuf;
    let is io.Writer as w = io.Writer(fd, cast(*u8, &wbuf), 16384);
    ws(&w, "// GENERATED by tools/gen.cst from WHATWG multi-byte indexes. DO NOT EDIT.\n");
    ws(&w, "// forward: pointer -> cp (1114112 = unmapped). gb18030 ranges: rp[i] pointer, rc[i] start cp.\n");
    ws(&w, "use \"../trie.cst\" as trie;\n\n");
    emit_flat_u32(&w, "mb_jis", jis, nj);
    emit_flat_u32(&w, "mb_big5", big, nb);
    emit_flat_u32(&w, "mb_euckr", euk, nk);
    emit_flat_u32(&w, "mb_gb", gbk, ng);
    emit_flat_u32(&w, "mb_rp", rp, nr);
    emit_flat_u32(&w, "mb_rc", rc, nr);
    emit_flat_u32(&w, "mb_jis212", j212, n212);
    emit_flat_u32(&w, "mb_rjc", rjc, nrj);
    emit_flat_u32(&w, "mb_rjp", rjp, nrj);
    emit_flat_u32(&w, "mb_rbc", rbc, nrb);
    emit_flat_u32(&w, "mb_rbp", rbp, nrb);
    emit_flat_u32(&w, "mb_rkc", rkc, nrk);
    emit_flat_u32(&w, "mb_rkp", rkp, nrk);
    emit_flat_u32(&w, "mb_rgc", rgc, nrg);
    emit_flat_u32(&w, "mb_rgp", rgp, nrg);
    ws(&w, "let is i32 as mb_jis212_n with imut = "); wi(&w, n212); ws(&w, ";\n");
    ws(&w, "let is i32 as mb_rj_n with imut = "); wi(&w, nrj); ws(&w, ";\n");
    ws(&w, "let is i32 as mb_rb_n with imut = "); wi(&w, nrb); ws(&w, ";\n");
    ws(&w, "let is i32 as mb_rk_n with imut = "); wi(&w, nrk); ws(&w, ";\n");
    ws(&w, "let is i32 as mb_rg_n with imut = "); wi(&w, nrg); ws(&w, ";\n");
    ws(&w, "let is i32 as mb_jis_n with imut = "); wi(&w, nj); ws(&w, ";\n");
    ws(&w, "let is i32 as mb_big5_n with imut = "); wi(&w, nb); ws(&w, ";\n");
    ws(&w, "let is i32 as mb_euckr_n with imut = "); wi(&w, nk); ws(&w, ";\n");
    ws(&w, "let is i32 as mb_gb_n with imut = "); wi(&w, ng); ws(&w, ";\n");
    ws(&w, "let is i32 as mb_rng_n with imut = "); wi(&w, nr); ws(&w, ";\n");
    io.flush(&w);
    io._close_fd(fd);
    io.write_str(1, "mbcs:  jis="); io.write_int(1, cast(i64, nj));
    io.write_str(1, " big5="); io.write_int(1, cast(i64, nb));
    io.write_str(1, " euckr="); io.write_int(1, cast(i64, nk));
    io.write_str(1, " gb="); io.write_int(1, cast(i64, ng));
    io.write_str(1, " ranges="); io.write_int(1, cast(i64, nr)); io.write_str(1, "\n");
    return 0;
}

fn main() as i32 {
    if (gen_gc() < 0)  { return 1; }
    if (gen_ccc() < 0) { return 2; }
    if (gen_enum_file("tools/ucd/Scripts.txt", "ucd/tables/script.cst", "script", "SC", "Unknown", U_MAXCP) < 0) { return 3; }
    if (gen_enum_file("tools/ucd/EastAsianWidth.txt", "ucd/tables/eaw.cst", "eaw", "EAW", "N", U_MAXCP) < 0) { return 4; }
    if (gen_enum_file("tools/ucd/LineBreak.txt", "ucd/tables/lb.cst", "lb", "LB", "XX", U_MAXCP) < 0) { return 5; }
    if (gen_enum_file("tools/ucd/GraphemeBreakProperty.txt", "ucd/tables/gcb.cst", "gcb", "GCB", "Other", U_MAXCP) < 0) { return 6; }
    if (gen_enum_file("tools/ucd/WordBreakProperty.txt", "ucd/tables/wb.cst", "wb", "WB", "Other", U_MAXCP) < 0) { return 7; }
    if (gen_enum_file("tools/ucd/SentenceBreakProperty.txt", "ucd/tables/sb.cst", "sb", "SB", "Other", U_MAXCP) < 0) { return 8; }
    if (gen_bidi() < 0) { return 9; }
    if (gen_decomp() < 0) { return 10; }
    if (gen_compose() < 0) { return 11; }
    if (gen_caseprops() < 0) { return 12; }
    if (gen_case_simple() < 0) { return 13; }
    if (gen_fold() < 0) { return 14; }
    if (gen_special() < 0) { return 15; }
    if (gen_extpict() < 0) { return 16; }
    if (gen_incb() < 0) { return 17; }
    if (gen_brackets() < 0) { return 18; }
    if (gen_mirror() < 0) { return 19; }
    if (gen_idna() < 0) { return 20; }
    if (gen_uideo() < 0) { return 21; }
    if (gen_collate() < 0) { return 22; }
    if (gen_sbcs() < 0) { return 23; }
    if (gen_mbcs() < 0) { return 24; }
    io.write_str(1, "gen: ok\n");
    return 0;
}

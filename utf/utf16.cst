// =======================================================
// caustic-unicode/utf/utf16.cst
// UTF-16 decode/encode/validate over host-endian *u16 unit arrays.
// Rejects unpaired surrogates. Same return convention as utf8.
// =======================================================

use "../core/errno.cst" as errno;
use "../core/buf.cst"   as buf;

// Decode one code point at unit index i. Writes to *out, returns units
// consumed (1 or 2), or 0 - UERR_* on unpaired surrogate / truncation.
fn decode1(units as *u16, n as i64, i as i64, out as *i32) as i64 {
    if (i >= n) { return 0 - errno.UERR_TRUNC; }
    let is i32 as u0 = cast(i32, units[i]);
    if (u0 < 55296 || u0 > 57343) { out[0] = u0; return 1; }       // BMP scalar
    if (u0 >= 56320) { return 0 - errno.UERR_INVALID; }            // lone low surrogate
    if (i + 1 >= n) { return 0 - errno.UERR_TRUNC; }
    let is i32 as u1 = cast(i32, units[i + 1]);
    if (u1 < 56320 || u1 > 57343) { return 0 - errno.UERR_INVALID; }
    out[0] = 65536 + ((u0 - 55296) << 10) + (u1 - 56320);
    return 2;
}

// Encode cp into dst (up to 2 units). Returns units written, or 0 - UERR_RANGE.
fn encode1(cp as i32, dst as *u16) as i64 {
    if (cp < 0 || cp > 1114111) { return 0 - errno.UERR_RANGE; }
    if (cp >= 55296 && cp <= 57343) { return 0 - errno.UERR_RANGE; }
    if (cp < 65536) { dst[0] = cast(u16, cp); return 1; }
    let is i32 as v = cp - 65536;
    dst[0] = cast(u16, 55296 + (v >> 10));
    dst[1] = cast(u16, 56320 + (v & 1023));
    return 2;
}

fn validate(units as *u16, n as i64) as i64 {
    let is i64 as i with mut = 0;
    let is i32 as cp with mut = 0;
    while (i < n) {
        let is i64 as k = decode1(units, n, i, &cp);
        if (k < 0) { return k; }
        i = i + k;
    }
    return 0;
}

// Encode n code points into the caller's u16 buffer (capacity `cap` units).
// Returns units written, or 0 - UERR_NOSPACE / 0 - UERR_RANGE.
fn from_cps(cps as *i32, n as i64, out as *u16, cap as i64) as i64 {
    let is [2]u16 as tmp;
    let is i64 as w with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i64 as k = encode1(cps[i], cast(*u16, &tmp));
        if (k < 0) { return k; }
        if (w + k > cap) { return 0 - errno.UERR_NOSPACE; }
        out[w] = tmp[0];
        if (k == 2) { out[w + 1] = tmp[1]; }
        w = w + k;
        i = i + 1;
    }
    return w;
}

fn to_cps(units as *u16, n as i64, out as *buf.CpBuf) as i64 {
    let is i64 as i with mut = 0;
    let is i64 as c with mut = 0;
    let is i32 as cp with mut = 0;
    while (i < n) {
        let is i64 as k = decode1(units, n, i, &cp);
        if (k < 0) { return k; }
        if (buf.cpbuf_push(out, cp) < 0) { return 0 - errno.UERR_NOSPACE; }
        i = i + k;
        c = c + 1;
    }
    return c;
}

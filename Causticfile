name "caustic-unicode"
version "0.0.1"
author "Caua"

target "test_buf" {
    src "tests/test_buf.cst"
    out "build/test_buf"
}

target "test_ucd" {
    src "tests/test_ucd.cst"
    out "build/test_ucd"
}

target "test_utf" {
    src "tests/test_utf.cst"
    out "build/test_utf"
}

target "test_width" {
    src "tests/test_width.cst"
    out "build/test_width"
}

target "test_normalize" {
    src "tests/test_normalize.cst"
    out "build/test_normalize"
}

target "conf_normalize" {
    src "tests/conformance/conf_normalize.cst"
    out "build/conf_normalize"
}

script "test" {
    "bash tests/run.sh"
}

script "gen" {
    "caustic tools/gen.cst -o build/gen && ./build/gen"
}

script "clean" {
    "rm -rf .caustic build"
}
